	<subDataset name="dataset1">
		<parameter name="idbv" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select * from lpabv_fotopada where lpabv_id = $P{idbv}]]>
		</queryString>
		<field name="lpabv_id" class="java.lang.Long"/>
		<field name="fotopada" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset2">
		<parameter name="idbv" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select * from lpabv_fasilitas where lpabv_id = $P{idbv}]]>
		</queryString>
		<field name="lpabv_id" class="java.lang.Long"/>
		<field name="fasilitas" class="java.lang.String"/>
	</subDataset>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select b.id id_bv, a.no_lpa,
a.nama_contact,
a.nama_debitur,
a.nama_perumahan,
a.lokasi_fisik,
a.kota,
a.kode_pos,
a.ditinjau nama_surveyor,
a.tanggal_order,
a.tanggal_survey,
a.tanggal_terima_dari_eks,
b.lokasi_ditemukan,
b.sudah_pindah,
b.ada_papan_nama,
b.kegiatan_usaha,
b.s1_ditemukan,
b.s1_nama,
b.s1_kelamin,
b.s1_hubungan,
b.s1_kooperatif,
--s2
b.s2_ditemukan,
b.s2_nama,
b.s2_kelamin,
b.s2_hubungan,
b.s2_kenal,
b.s2_kooperatif,
--s2
b.s3_ditemukan,
b.s3_nama,
b.s3_kelamin,
b.s3_hubungan,
b.s3_kenal,
b.s3_kooperatif,
--
b.diterima_di,
b.jumlah_karyawan,
b.omzet_penjualan,
b.kondisi_usaha,
b.jenis_usaha,
b.lama_penempatan,
b.lingkungan_sekitar,
b.jalan_tempat_usaha,
b.kondisi_usaha,
b.luas_bangunan,
b.luas_tanah,
b.jenis_bangunan,
b.status_usaha,
b.status_lokasi,
b.info_s1,
b.info_s2,
b.info_s3, b.note,
b.bertingkat,
b.jumlah_mobil,
b.jumlah_motor,
b.jumlah_truk,
(select nama from person where user_id = e.closed_by ) approve_by,
e.closed_date approve_date,
(select nama from person where user_id = e.value_by ) value_by,
e.value_date
from lpa_umum a
inner join lpa_bv b on b.id_lpa_umum = a.id
left join data_umum e on a.id_data_umum = e.id
where a.id=$P{PIdLpaUmum}]]>
	</queryString>
