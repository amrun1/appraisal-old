<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptSla" pageWidth="3050" pageHeight="100" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="3050" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="5099"/>
	<property name="ireport.y" value="0"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
	<property name="net.sf.jasperreports.export.html.remove.empty.space.between.rows" value="true"/>
	<property name="net.sf.jasperreports.export.html.white.page.background" value="true"/>
	<property name="net.sf.jasperreports.export.html.frames.as.nested.tables" value="true"/>
	<property name="net.sf.jasperreports.export.html.using.images.to.align" value="false"/>
	<subDataset name="Bisnis">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from cabang
where id = $P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="Cabang">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from appraisal_cabang
where id = $P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="JenisAppraisal">
		<parameter name="id" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="id_umum" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select case when b.kategori_appraisal = 'Internal' then 'Internal' when b.kategori_appraisal = 'Eksternal' then 'Eksternal' else a.nama end nama
from jenis_appraisal a
left outer join data_umum b on a.id=b.jenis_appraisal_id
where a.id = $P{id}
and b.id = $P{id_umum}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="user">
		<parameter name="pUserId" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.nama
from person a
-- , person_roles b
where a.user_id = $P{pUserId}
-- and a.user_id = b.user_id]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="statusJaminan">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from status_jaminan
where id = $P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="jenisAktiva">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from jenis_aktiva
where id =$P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<parameter name="pCabangApppraisal" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pPosisi" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pSubmitDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pCloseDate" class="java.sql.Timestamp">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pUserId" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pUserName" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="pTimUser" class="java.lang.Integer"/>
	<parameter name="pCabang" class="java.lang.Long"/>
	<parameter name="pCabangDesk" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select c.id,
c.no_order,
a.nama_debitur,
a.ditinjau,
(select p.nama from person p where p.user_id = c.value_by) value_by,
(select p.nama from person p where p.user_id = c.closed_by) closed_by,
(select nama from status_jaminan where id = c.status_jaminan_id) status_jaminan_id,
(select p.nama from person p where p.user_id = c.created_by) created_by,
c.appraisal_cabang_id cabang,
(select nama from cabang where id = c.cabang_id) bisnis,
(select nama from jenis_aktiva where id = b.id_jenis_aktiva) object_penilaian,
b.alamat lokasi_agunan,
b.kode_kota,
b.kode_propinsi,
b.kode_pos,
c.submit_date tanggal_order,
a.tanggal_survey,
c.value_date,
--tglapproval
--sla admin jam
coalesce(i.jml_sla_admin,0) sla_admin,
--sla valuer
coalesce(i.jml_sla_valuer,0) sla_valuer,
--sla surveyor
coalesce(jml_sla_surveyor,0) sla_surveyor,
--sla approval
coalesce(jml_sla_approval,0) sla_approval,
--total sla
coalesce(jml_sla_admin,0)+coalesce(jml_sla_valuer,0)+coalesce(jml_sla_surveyor,0)+coalesce(jml_sla_approval,0) total_sla,
d.total_luas_tanah_doc luas_tanah,
d.luas_bangunan,
case when d.total_doc_eks is not null or d.total_sesuai_doc is not null then (case when d.total_doc_eks is not null and d.total_doc_eks > 0 then d.total_doc_eks else  d.total_sesuai_doc end)
	when f.nilai_doc_pasar is not null or f.nilai_doc_pasar_eks is not null then (case when f.nilai_doc_pasar_eks is not null and f.nilai_doc_pasar_eks > 0 then f.nilai_doc_pasar_eks else  f.nilai_doc_pasar end)
	when g.total_doc is not null or g.total_doc_eks is not null then (case when g.total_doc_eks is not null and g.total_doc_eks > 0 then g.total_doc_eks else  g.total_doc end)
	when h.nilai_dokumen is not null or h.nilai_dokumen_eks is not null then (case when h.nilai_dokumen_eks is not null and h.nilai_dokumen_eks > 0 then h.nilai_dokumen_eks else  h.nilai_dokumen end)
	else (case when e.nilai_doc_pasar_eks is not null and e.nilai_doc_pasar_eks > 0 then e.nilai_doc_pasar_eks else  e.nilai_doc_pasar end) end total_sesuai_doc,
case when d.total_fisik_eks is not null or d.total_sesuai_fisik is not null then (case when d.total_fisik_eks is not null and d.total_fisik_eks > 0 then d.total_fisik_eks else  d.total_sesuai_fisik end)
	when f.nilai_fisik_pasar is not null or f.nilai_fisik_pasar_eks is not null then (case when f.nilai_fisik_pasar_eks is not null and f.nilai_fisik_pasar_eks > 0 then f.nilai_fisik_pasar_eks else  f.nilai_fisik_pasar end)
	when g.total_fisik is not null or g.total_fisik_eks is not null then (case when g.total_fisik_eks is not null and g.total_fisik_eks > 0 then g.total_fisik_eks else  g.total_fisik end)
	when h.nilai_fisik is not null or h.nilai_fisik_eks is not null then (case when h.nilai_fisik_eks is not null and h.nilai_fisik_eks > 0 then h.nilai_fisik_eks else  h.nilai_fisik end)
	else (case when e.nilai_fisik_pasar_eks is not null and e.nilai_fisik_pasar_eks > 0 then e.nilai_fisik_pasar_eks else  e.nilai_fisik_pasar end) end total_sesuai_fisik,
case when d.nilai_fisik_1_eks is not null and d.nilai_fisik_1_eks > 0 then d.nilai_fisik_1_eks else  d.nilai_fisik_1 end harga_tanah,
case when d.nilai_fisik_2_eks is not null and d.nilai_fisik_2_eks > 0 then d.nilai_fisik_2_eks else  d.nilai_fisik_2 end harga_bangunan,
c.kategori_appraisal jenis_lpa,
c.jenis_appraisal_id,
c.jenis_laporan,
c.submit_date,
c.closed_date,
b.nama_pic,
-- jumlah_hari(C.submit_date, C.closed_date)
CEIL((coalesce(jml_sla_admin,0)+coalesce(jml_sla_valuer,0)+coalesce(jml_sla_surveyor,0)+coalesce(jml_sla_approval,0))/24) as hari_kerja,
(select nama from jenis_appraisal x where x.id = c.jenis_appraisal_id) jenis_app
from lpa_umum a
left join data_detail b on a.id_data_detail = b.id
left join data_umum c on c.id = b.id_data_umum
left join lpa_tanah_bangunan d on d.id_lpa_umum = a.id
left join lpa_mesin e on e.id_lpa_umum = a.id
left join lpa_kapal f on f.id_lpa_umum = a.id
left join lpa_kendaraan g on g.id_lpa_umum = a.id
left join lpa_stock h on h.id_lpa_umum = a.id
left join v_sla_hitung i on i.id_umum = c.id
where c.appraisal_cabang_id=$P{pCabangApppraisal} and coalesce(c.closed_date, c.value_date) between $P{pSubmitDate} and $P{pCloseDate}
and c.submit_date is not null
and c.posisi = 'CLOSE'
and ( $P{pCabang} is null or c.cabang_id = $P{pCabang})
$P!{pUserId}
order by c.closed_date asc]]>
	</queryString>
	<field name="id" class="java.lang.Long"/>
	<field name="no_order" class="java.lang.String"/>
	<field name="nama_debitur" class="java.lang.String"/>
	<field name="ditinjau" class="java.lang.String"/>
	<field name="value_by" class="java.lang.String"/>
	<field name="closed_by" class="java.lang.String"/>
	<field name="status_jaminan_id" class="java.lang.String"/>
	<field name="created_by" class="java.lang.String"/>
	<field name="cabang" class="java.lang.Long"/>
	<field name="bisnis" class="java.lang.String"/>
	<field name="object_penilaian" class="java.lang.String"/>
	<field name="lokasi_agunan" class="java.lang.String"/>
	<field name="kode_kota" class="java.lang.String"/>
	<field name="kode_propinsi" class="java.lang.String"/>
	<field name="kode_pos" class="java.lang.String"/>
	<field name="tanggal_order" class="java.sql.Timestamp"/>
	<field name="tanggal_survey" class="java.sql.Timestamp"/>
	<field name="value_date" class="java.sql.Timestamp"/>
	<field name="sla_admin" class="java.lang.Double"/>
	<field name="sla_valuer" class="java.lang.Double"/>
	<field name="sla_surveyor" class="java.lang.Double"/>
	<field name="sla_approval" class="java.lang.Double"/>
	<field name="total_sla" class="java.lang.Double"/>
	<field name="luas_tanah" class="java.lang.Double"/>
	<field name="luas_bangunan" class="java.lang.Double"/>
	<field name="total_sesuai_doc" class="java.math.BigDecimal"/>
	<field name="total_sesuai_fisik" class="java.math.BigDecimal"/>
	<field name="harga_tanah" class="java.math.BigDecimal"/>
	<field name="harga_bangunan" class="java.math.BigDecimal"/>
	<field name="jenis_lpa" class="java.lang.String"/>
	<field name="jenis_appraisal_id" class="java.lang.Long"/>
	<field name="jenis_laporan" class="java.lang.String"/>
	<field name="submit_date" class="java.sql.Timestamp"/>
	<field name="closed_date" class="java.sql.Timestamp"/>
	<field name="nama_pic" class="java.lang.String"/>
	<field name="hari_kerja" class="java.lang.Double"/>
	<field name="jenis_app" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="60" splitType="Stretch">
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="3050" height="15" backcolor="#CCCCCC"/>
