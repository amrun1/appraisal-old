<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptFormatLpaInt" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="3.2210200000000024"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="51"/>
	<subDataset name="dataset1">
		<parameter name="pId" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.value
from parameter a
where a.id::text =$P{pId}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select distinct a.nama_debitur,
        a.nama_perumahan,
        a.nama_cluster,
        a.posisi_lokasi_agunan,
        a.block,
        a.nomor,
        a.rt,
        a.rw,
a.lokasi_fisik alamat,
a.jenis_object_fisik,
a.sla,
        a.propinsi,
        a.kota,
        a.kecamatan,
        a.kelurahan,
        a.kode_pos,
        (select cb.nama from cabang cb where cb.id=a.id_app_cabang) as id_app_cabang,
        a.nomor_order,
        a.no_lpa,
        a.jenis_object,
        e.submit_date tanggal_order,
        a.tanggal_survey,
        a.dituju_ke,
        a.ditinjau,
        a.nama_contact,
        (select x.nama from status_jaminan x where x.id = a.id_status_jaminan) status_jaminan,
        a.kategori_sla,
b.biaya_di_lampirkan,
b.biaya_tidak_di_perhitungkan,
b.tidak_diperhitungan_1,
b.tidak_diperhitungan_2,
b.tidak_diperhitungan_3,
b.tidak_diperhitungan_4,
b.tidak_diperhitungan_5,
b.txt_tidak_diperhitungan_1,
b.txt_tidak_diperhitungan_2,
b.txt_tidak_diperhitungan_3,
b.txt_tidak_diperhitungan_4,
b.txt_tidak_diperhitungan_5,
b.biaya_di_perhitungkan,
b.luas_bangunan,
b.harga_bangunan_rab,
b.harga_bangunan_internal,
b.nilai_review_customer,
b.nilai_review_internal,
b.kewajaran_nilai,
(select y.closed_by from data_detail x inner join data_umum y on y.id = x.id_data_umum where x.id = a.id_data_detail) approve_by,
(select y.closed_date from data_detail x inner join data_umum y on y.id = x.id_data_umum where x.id = a.id_data_detail) approve_date,
(select y.value_by from data_detail x inner join data_umum y on y.id = x.id_data_umum where x.id = a.id_data_detail) value_by,
(select y.value_date from data_detail x inner join data_umum y on y.id = x.id_data_umum where x.id = a.id_data_detail) value_date,
jumlah_hari(e.submit_date, e.closed_date) hari_kerja, e.jenis_laporan
from lpa_umum a
left join data_umum e on a.id_data_umum = e.id
left join lpa_rab b on b.id_lpa_umum = a.id
where a.id=$P{PIdLpaUmum}
LIMIT 1]]>
	</queryString>
