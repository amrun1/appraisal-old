<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptLpaStock" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.1289478601075607"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="dataset1">
		<parameter name="pId" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.value
from parameter a
where a.id::text = $P{pId}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<subDataset name="negative list">
		<parameter name="id_lpa" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select distinct y.value from lpa_umum_negatif_point x left join parameter y on x.id_parameter=y.id where x.id_lpa=$P{id_lpa}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<subDataset name="khusus">
		<parameter name="id_lpa" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select distinct y.value from lpa_umum_pertimbangan_khusus x left join parameter y on x.id_parameter=y.id where x.id_lpa=$P{id_lpa}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select distinct a.nama_debitur,
        a.nama_perumahan,
        a.nama_cluster,
        a.posisi_lokasi_agunan,
regexp_replace(a.lokasi_fisik, '\r\n', ' ', 'g') alamat,
a.jenis_object_fisik,
a.sla,
        a.block,
        a.nomor,
        a.rt,
        a.rw,
        a.propinsi,
        a.kota,
        a.kecamatan,
        a.kelurahan,
        a.kode_pos,
        (select cb.kode_cabang from cabang cb where cb.id=a.id_app_cabang) as id_app_cabang,
        a.nomor_order,
        a.no_lpa,
        a.jenis_object,
        a.tanggal_order,
        a.tanggal_survey,
        a.dituju_ke,
        a.ditinjau,
        a.nama_contact,
        (select x.nama from status_jaminan x where x.id = a.id_status_jaminan) status_jaminan,
        a.kategori_sla,
(select distinct y.value from lpa_umum_negatif_point x inner join parameter y on x.id_parameter=y.id where x.id_lpa=a.id LIMIT 1) negativ_list,
(select distinct y.value from lpa_umum_pertimbangan_khusus x inner join parameter y on x.id_parameter=y.id where x.id_lpa=a.id LIMIT 1) perkembangan_khusus,
a.catatan_point,
a.pembanding_1,
a.pembanding_2,
a.pembanding_3,
(select nama from person where user_id = e.closed_by ) approve_by,
e.closed_date approve_date,
(select nama from person where user_id = e.value_by ) value_by,
e.value_date,
a.deviasi_doc,
a.deviasi_fisik,
a.opini_internal,
a.catatan_point,
jumlah_hari(e.submit_date, e.closed_date) hari_kerja,
b.jenis_persediaan,
b.asal_pembuatan,
b.penempatan_barang,
b.kemasan_barang,
b.kondisi_barang,
b.metode_pemeriksaan,
b.jumlah_persediaan,
b.jenis_dokumen,
b.nomor_dokumen,
b.tanggal_dokumen,
b.jenis_penyimpanan,
b.kondisi_penyimpanan,
b.lingkungan_sekitar,
b.peralatan_gudang,
a.faktor_marketability,
b.nilai_dokumen nilai_pasar_dok,
b.likuidasi_dokumen nilai_lik_dok,
b.nilai_fisik nilai_pasar_fisik,
b.likuidasi_fisik nilai_lik_fisik,
b.nilai_dokumen_eks nilai_pasar_dok_eks,
b.likuidasi_dokumen_eks nilai_lik_dok_eks,
b.nilai_fisik_eks nilai_pasar_fisik_eks,
b.likuidasi_fisik_eks nilai_lik_fisik_eks,
a.FAKTOR_MARKET_CATATAN,
a.catatan_kesesuaian,
a.catatan_kewajaran_nilai, a.tanggal_penilaian,
b.beri_nilai_dokumen,
b.beri_nilai_fisik,
b.beri_nilai_dokumen_eks,
b.beri_nilai_fisik_eks, e.jenis_laporan
from lpa_umum a
inner join lpa_stock b on b.id_lpa_umum =a.id
left join data_umum e on a.id_data_umum = e.id
where a.id = $P{PIdLpaUmum}
LIMIT 1]]>
	</queryString>
