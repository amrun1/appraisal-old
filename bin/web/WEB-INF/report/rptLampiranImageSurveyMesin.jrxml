					<font size="6"/>
				</textElement>
				<text><![CDATA[Laporan ini merupakan hasil cetakan komputer, tidak memerlukan tanda tangan.]]></text>
			</staticText>
			<line>
				<reportElement key="line" x="0" y="21" width="555" height="1" forecolor="#FF99CC"/>
			</line>
