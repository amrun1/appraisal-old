<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptUser" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="842" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.1435888100000016"/>
	<property name="ireport.x" value="986"/>
	<property name="ireport.y" value="0"/>
	<property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.columns" value="true"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
	<queryString>
		<![CDATA[select p.user_id,
p.nama,
case when pr.person_level = 'MARKETING' then cab.nama else app_cab.nama end departement,
case when p.sum_failure>3 then 'Locked' when p.inactive = false then 'Active' else 'Inactive' end status,
pr.person_level roles,
logs.date_time created_date,
p.last_login
from person p
left join person_roles pr on pr.user_id=p.user_id
left join appraisal_cabang app_cab on app_cab.id=pr.app_cabang_id
left join cabang cab on cab.id=pr.cabang_id,
security_log logs
where logs.keterangan = 'User ID Creation'
and logs.user_affected=p.user_id]]>
	</queryString>
	<field name="user_id" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="departement" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="roles" class="java.lang.String"/>
	<field name="created_date" class="java.sql.Timestamp"/>
	<field name="last_login" class="java.sql.Timestamp"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="30" splitType="Stretch">
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="100" height="30" backcolor="#CCCCCC"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Nama User ID]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="100" y="0" width="133" height="30" backcolor="#CCCCCC"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Nama Pemilik User ID]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="233" y="0" width="131" height="30" backcolor="#CCCCCC"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Nama Departemen/Unit ]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="364" y="0" width="100" height="30" backcolor="#CCCCCC"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Status ]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="464" y="0" width="148" height="30" backcolor="#CCCCCC"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Group Role Menu]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="612" y="0" width="115" height="30" backcolor="#CCCCCC"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Creation Date]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="727" y="0" width="115" height="30" backcolor="#CCCCCC"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Last Login]]></text>
			</staticText>
		</band>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="20" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="100" height="20"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{user_id}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="100" y="0" width="133" height="20"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{nama}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="233" y="0" width="131" height="20"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{departement}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="364" y="0" width="100" height="20"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{status}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="464" y="0" width="148" height="20"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{roles}]]></textFieldExpression>
			</textField>
			<textField pattern="dd-MM-yyyy HH:mm:ss" isBlankWhenNull="true">
				<reportElement x="612" y="0" width="115" height="20"/>
				<textElement/>
				<textFieldExpression class="java.sql.Timestamp"><![CDATA[$F{created_date}]]></textFieldExpression>
			</textField>
			<textField pattern="dd-MM-yyyy HH:mm:ss" isBlankWhenNull="true">
				<reportElement x="727" y="0" width="115" height="20"/>
				<textElement/>
