<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="subRptFormatLpaIntDt1" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id_lpa_umum" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select distinct a.nama_debitur,
        a.nama_perumahan,
        a.nama_cluster,
        a.posisi_lokasi_agunan,regexp_replace(a.lokasi_fisik, '\r\n', ' ', 'g') alamat,
        a.block,
        a.nomor,
        a.rt,
        a.rw,
        a.propinsi,
        a.kota,
        a.kecamatan,
        a.kelurahan,
        a.kode_pos,
        a.id_app_cabang,
        a.nomor_order,
        a.no_lpa,
        a.jenis_object,a.jenis_object_fisik,
        a.tanggal_order,
        a.tanggal_survey,
        a.dituju_ke,
        a.ditinjau,
        a.nama_contact, a.sla,
        (select x.nama from status_jaminan x where x.id = a.id_status_jaminan) status_jaminan,
        a.kategori_sla,
(select distinct nama from jenis_dokumen where id= d.id_jenis_dokumen ) jenis_dokumen,
d.nama_dokumen no_dokumen,
d.nama_jalan,
d.block block_data_bgn,
d.nomor nomor_dt_bgn,
d.rt rt_dt_bgn,
d.rw rw_dt_bgn,
d.propinsi prop_dt_bgn,
d.kota kota_dt_bgn,
d.kecamatan camat_dt_bgn,
d.kelurahan lurah_dt_bgn,
d.tanggal_sertifikat,
d.tanggal_akhir_hak,
d.surat_ukur,
d.tanggal_surat_ukur,
d.nama_pemegang_hak,
d.luas_tanah,
b.luas_sesuai_tata_kota,
b.bentuk_tanah,
b.kondisi_tanah,
b.kontur_tanah,
b.ketinggian_tanah,
b.peruntukan_tanah,
b.batas_utara,
b.batas_selatan,
b.batas_barat,
b.batas_timur,
c.nomor_imb,
c.tanggal_imb,
c.ijin_sesuai_imb,
b.luas_bangunan_imb,
c.luas_bangunan,
b.luas_lantai_1,
b.luas_lantai_2,
b.luas_lantai_3,
b.luas_lantai_4,
b.luas_lantai_5,
c.jumlah_lantai,
b.jml_lantai_fisik,
b.jml_lantai_depan,
b.jenis_bangunan,
b.kelas_bangungan,
b.digunakan_sebagai,
b.dihuni_oleh,
b.status_agunan,
b.status_bangunan,
b.proses_pembangunan,
b.lingkungan_sekitar,
b.tingkat_kepadatan,
b.tingkat_kemacetan,
b.rencana_jalan,
b.lebar_jalan,
b.gsb,
b.gss,
b.kendaraan_roda_4,
a.faktor_marketability,
b.harga_tanah,
b.harga_bangunan,
jumlah_hari(e.submit_date, e.closed_date) hari_kerja
from lpa_umum a
left join data_umum e on a.id_data_umum = e.id
left join lpa_tanah_bangunan b on b.id_lpa_umum = a.id
left join lpa_doc_bangunan c on c.id_lpa_umum = b.id
left join lpa_doc_tanah d on d.id_lpa_lnb = b.id
where a.id = $P{id_lpa_umum}
LIMIT 1]]>
	</queryString>
