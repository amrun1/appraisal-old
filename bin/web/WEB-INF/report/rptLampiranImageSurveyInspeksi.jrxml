<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptLampiranImageSurveyInspeksi" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.1000000000000005"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="net.sf.jasperreports.engine.util.JRImageLoader" value="true"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="net.sf.jasperreports.export.pdf.compressed" value="false"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<parameter name="PImagePath" class="java.lang.String"/>
	<queryString>
		<![CDATA[select * from
(select gbr.*, ROW_NUMBER() OVER (ORDER BY (SELECT 1)) :: Integer AS no2  from (select a.no_lpa,
a.nama_debitur,
a.lokasi_fisik, b.id_laporan_dokumen,
lo_get(b.image) img, b.nama ket, coalesce(b.catatan, '') catatan,
(select nama from jenis_kategori where kode = a.kategori_aktiva) kategori,
ROW_NUMBER() OVER (ORDER BY (SELECT 1)) :: Integer % 2 AS no
from lpa_umum a
left outer join (
select b.id_laporan_dokumen, b.image, c.nama, b.id_survey_umum, b.id_lpa, b.catatan
from survey_image b
	left outer join jenis_laporan_dokumen c on b.id_laporan_dokumen = c.id
where c.jenis_data='Foto Survey'
) as b
	on a.id_survey = b.id_survey_umum or a.id = b.id_lpa
where a.id =$P{PIdLpaUmum}
order by B.nama) gbr
where gbr.no = 1) gbr1
left join (select gbr.*, ROW_NUMBER() OVER (ORDER BY (SELECT 1)) :: Integer AS no2  from (select
lo_get(b.image) img2, b.nama ket2, coalesce(b.catatan, '') catatan2,
(select nama from jenis_kategori where kode = a.kategori_aktiva) kategori2,
ROW_NUMBER() OVER (ORDER BY (SELECT 1)) :: Integer % 2 AS no
from lpa_umum a
left outer join (
select b.id_laporan_dokumen, b.image, c.nama, b.id_survey_umum, b.id_lpa, b.catatan
from survey_image b
	left outer join jenis_laporan_dokumen c on b.id_laporan_dokumen = c.id
where c.jenis_data='Foto Survey'
) as b
	on a.id_survey = b.id_survey_umum or a.id = b.id_lpa
where a.id =$P{PIdLpaUmum}
order by B.nama) gbr
where gbr.no = 0) gbr2 on gbr1.no2 =gbr2.no2]]>
	</queryString>
	<field name="no_lpa" class="java.lang.String"/>
	<field name="nama_debitur" class="java.lang.String"/>
	<field name="lokasi_fisik" class="java.lang.String"/>
	<field name="id_laporan_dokumen" class="java.lang.Long"/>
	<field name="img" class="java.io.InputStream"/>
	<field name="ket" class="java.lang.String"/>
	<field name="catatan" class="java.lang.String"/>
	<field name="kategori" class="java.lang.String"/>
	<field name="no" class="java.lang.Integer"/>
	<field name="no2" class="java.lang.Integer"/>
	<field name="img2" class="java.io.InputStream"/>
	<field name="ket2" class="java.lang.String"/>
	<field name="catatan2" class="java.lang.String"/>
	<field name="kategori2" class="java.lang.String"/>
