<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptFormatLpaDesktop" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.6500000000000106"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="749"/>
	<subDataset name="khusus">
		<parameter name="id_lpa" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select distinct y.value from lpa_umum_pertimbangan_khusus x left join parameter y on x.id_parameter=y.id where x.id_lpa=$P{id_lpa}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<subDataset name="negative list">
		<parameter name="id_lpa" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select distinct y.value from lpa_umum_negatif_point x left join parameter y on x.id_parameter=y.id where x.id_lpa=$P{id_lpa}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select distinct a.nama_debitur,
        a.nama_perumahan,
        a.nama_cluster,
        a.posisi_lokasi_agunan,
regexp_replace(a.lokasi_fisik, '\r\n', ' ', 'g') alamat,
a.jenis_object_fisik,
a.sla,
        a.block,
        a.nomor,
        a.rt,
        a.rw,
        a.propinsi,
        a.kota,
        a.kecamatan,
        a.kelurahan,
        a.kode_pos,
        (select cb.nama from cabang cb where cb.id=e.cabang_id) as id_app_cabang,
        a.nomor_order,
        a.no_lpa,
        a.jenis_object,
        e.submit_date tanggal_order,
        a.tanggal_survey,
        a.dituju_ke,
        a.ditinjau,
        a.nama_contact,
        (select x.nama from status_jaminan x where x.id = a.id_status_jaminan) status_jaminan,
        a.kategori_sla,
(select distinct nama from jenis_dokumen where id= d.id_jenis_dokumen ) jenis_dokumen,
d.nama_dokumen no_dokumen,
d.nama_jalan,
d.block block_data_bgn,
d.nomor nomor_dt_bgn,
d.rt rt_dt_bgn,
d.rw rw_dt_bgn,
d.propinsi prop_dt_bgn,
d.kota kota_dt_bgn,
d.kecamatan camat_dt_bgn,
d.kelurahan lurah_dt_bgn,
d.tanggal_sertifikat,
d.tanggal_akhir_hak,
d.surat_ukur,
d.tanggal_surat_ukur,
d.nama_pemegang_hak,
d.luas_tanah,
b.luas_sesuai_tata_kota,
b.bentuk_tanah,
b.kondisi_tanah,
b.kontur_tanah,
b.ketinggian_tanah,
b.peruntukan_tanah,
b.batas_utara,
b.batas_selatan,
b.batas_barat,
b.batas_timur,
c.nomor_imb,
c.tanggal_imb,
c.ijin_sesuai_imb,
b.hitung_dokumen_1 diberi_nilai_dok_tanah,
b.hitung_dokumen_2 diberi_nilai_dok_bgn,
b.hitung_fisik_1 diberi_nilai_fisik_tanah,
b.hitung_fisik_2 diberi_nilai_fisik_bgn,
b.luas_bangunan_imb,
b.luas_bangunan,
b.luas_lantai_1,
b.luas_lantai_2,
b.luas_lantai_3,
b.luas_lantai_4,
b.luas_lantai_5,
c.jumlah_lantai,
b.jml_lantai_fisik,
b.jml_lantai_depan,
b.jenis_bangunan,
b.kelas_bangungan,
b.digunakan_sebagai,
b.dihuni_oleh,
b.status_agunan,
b.status_bangunan,
b.proses_pembangunan,
b.lingkungan_sekitar,
b.tingkat_kepadatan,
b.tingkat_kemacetan,
b.rencana_jalan,
b.lebar_jalan,
b.gsb,
b.gss,
b.kendaraan_roda_4,
a.faktor_marketability,
b.harga_tanah,
b.harga_bangunan,
b.nilai_dokumen_1 nilai_pasar_dok_tanah, b.nilai_dokumen_2 nilai_pasar_dok_bgn, b.total_sesuai_doc total_pasar_dok,
b.likuidasi_doc_1 nilai_lik_dok_tanah,b.likuidasi_doc_2 nilai_lik_dok_bgn, b.total_likuidasi_doc total_lik_dok,
b.nilai_fisik_1 nilai_pasar_fisik_tanah, b.nilai_fisik_2 niali_pasar_fisik_bgn, b.total_sesuai_fisik total_pasar_fisik,
b.likuidasi_fisik_1 nilai_lik_fisik_tanah, b.likuidasi_fisik_2 nilai_lik_fisik_bgn,b.total_likuidasi_fisik total_lik_fisik,
b.harga_tanah_eks,
b.harga_bangunan_eks,
b.nilai_doc_1_eks nilai_pasar_dok_tanah_eks, b.nilai_doc_2_eks nilai_pasar_dok_bgn_eks, b.total_doc_eks total_pasar_dok_eks,
b.likuidasi_doc_1_eks nilai_lik_dok_tanah_eks,b.likuidasi_doc_2_eks nilai_lik_dok_bgn_eks, b.total_likuidasi_doc_eks total_lik_dok_eks,
b.nilai_fisik_1_eks nilai_pasar_fisik_tanah_eks, b.nilai_fisik_2_eks niali_pasar_fisik_bgn_eks, b.total_fisik_eks total_pasar_fisik_eks,
b.likuidasi_fisik_1_eks nilai_lik_fisik_tanah_eks, b.likuidasi_fisik_2_eks nilai_lik_fisik_bgn_eks,b.total_likuidasi_fisik_eks total_lik_fisik_eks,
(select distinct y.value from lpa_umum_negatif_point x inner join parameter y on x.id_parameter=y.id where x.id_lpa=a.id LIMIT 1) negativ_list,
(select distinct y.value from lpa_umum_pertimbangan_khusus x inner join parameter y on x.id_parameter=y.id where x.id_lpa=a.id LIMIT 1) perkembangan_khusus,
a.catatan_point,
a.pembanding_1,
a.pembanding_2,
a.pembanding_3,
(select nama from person where user_id = e.closed_by ) approve_by,
e.closed_date approve_date,
(select nama from person where user_id = e.value_by ) value_by,
e.value_date,
a.deviasi_doc,
a.deviasi_fisik,
a.opini_internal,
a.catatan_point,
jumlah_hari(e.submit_date, e.closed_date) hari_kerja,
(select count(bgn.id) from lpa_doc_bangunan bgn where bgn.id_lpa_umum=b.id ) count_bangunan,
(select count(tnh.id) from lpa_doc_tanah tnh where tnh.id_lpa_lnb=b.id ) count_tanah,
b.kesesuaian_batas,
a.FAKTOR_MARKET_CATATAN,b.total_luas_tanah_doc, e.jenis_laporan
from lpa_umum a
left join data_umum e on a.id_data_umum = e.id
left join lpa_tanah_bangunan b on b.id_lpa_umum = a.id
left join lpa_doc_bangunan c on c.id_lpa_umum = b.id
left join lpa_doc_tanah d on d.id_lpa_lnb = b.id
where a.id = $P{PIdLpaUmum}
LIMIT 1]]>
	</queryString>
