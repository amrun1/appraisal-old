<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptOrder" pageWidth="556" pageHeight="841" whenNoDataType="NoDataSection" columnWidth="556" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.2100000000000006"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
	<subDataset name="dataset1">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from cabang
where id = $P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset2">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from jenis_aktiva
where id =$P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset3">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from appraisal_cabang
where id = $P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset4">
		<parameter name="pUserId" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select distinct(a.nama) as nama
from person a,
person_roles b
where a.user_id = b.user_id
and b.person_level = 'MARKETING'
and a.user_id = $P{pUserId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<parameter name="pSubmitDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pCloseDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pCabangId" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pAppraisalCabangId" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select count(c.nama), c.nama, date(b.submit_date), c.id
from data_detail a
left join data_umum b on a.id_data_umum = b.id
left join (select case x.id when 2 then y.kategori_appraisal else x.nama end nama, x.id id, y.id id_umum from jenis_appraisal x, data_umum y where x.id = y.jenis_appraisal_id and y.kategori_appraisal is not null) c on c.id_umum = b.id
where b.cabang_id = $P{pCabangId}
and b.appraisal_cabang_id = $P{pAppraisalCabangId}
and b.kategori_appraisal is not null
and date(b.submit_date) between $P{pSubmitDate} and $P{pCloseDate}
and b.posisi <> 'User_TL'
group by c.nama,
 date(b.submit_date), c.id
order by date(b.submit_date) asc]]>
	</queryString>
	<field name="count" class="java.lang.Long"/>
	<field name="nama" class="java.lang.String"/>
	<field name="date" class="java.sql.Date"/>
	<field name="id" class="java.lang.Long"/>
	<variable name="vOther" class="java.lang.Long" resetType="Group" resetGroup="date" calculation="Sum">
		<variableExpression><![CDATA[$F{id}!= 2 && $F{id}!= 50 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vEksternal" class="java.lang.Long" resetType="Group" resetGroup="date" calculation="Sum">
		<variableExpression><![CDATA[!$F{nama}.equals( "Internal" ) && $F{id}!= 50 && $F{id}!= 1050 && $F{id}!= 1051 && $F{id}!= 1052 && $F{id}!= 4 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vInternal" class="java.lang.Long" resetType="Group" resetGroup="date" calculation="Sum">
		<variableExpression><![CDATA[!$F{nama}.equals( "Eksternal" ) && $F{id}!= 50 && $F{id}!= 1050 && $F{id}!= 1051 && $F{id}!= 1052 && $F{id}!= 4  ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vIndikasi" class="java.lang.Long" resetType="Group" resetGroup="date" calculation="Sum">
		<variableExpression><![CDATA[$F{id}!= 2 && $F{id}!= 1050 && $F{id}!= 1051 && $F{id}!= 1052 && $F{id}!= 4 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vOtherTotal" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{id}!= 2 && $F{id}!= 50 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vEksternalTotal" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[!$F{nama}.equals( "Internal" ) && $F{id}!= 50 && $F{id}!= 1050 && $F{id}!= 1051 && $F{id}!= 1052 && $F{id}!= 4  ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vInternalTotal" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[!$F{nama}.equals( "Eksternal" ) && $F{id}!= 50 && $F{id}!= 1050 && $F{id}!= 1051 && $F{id}!= 1052 && $F{id}!= 4  ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vIndikasiTotal" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{id}!= 2 && $F{id}!= 1050 && $F{id}!= 1051 && $F{id}!= 1052 && $F{id}!= 4 ? $F{count} :0]]></variableExpression>
	</variable>
	<group name="date">
		<groupExpression><![CDATA[$F{date}]]></groupExpression>
		<groupHeader>
			<band height="20">
				<textField pattern="yyyy-MM-dd">
					<reportElement mode="Opaque" x="0" y="0" width="100" height="20"/>
					<textElement/>
					<textFieldExpression class="java.util.Date"><![CDATA[$F{date}]]></textFieldExpression>
				</textField>
				<textField evaluationTime="Group" evaluationGroup="date">
					<reportElement mode="Opaque" x="230" y="0" width="100" height="20"/>
					<textElement textAlignment="Center"/>
					<textFieldExpression class="java.lang.Long"><![CDATA[$V{vEksternal}]]></textFieldExpression>
				</textField>
				<textField evaluationTime="Group" evaluationGroup="date">
					<reportElement mode="Opaque" x="430" y="0" width="126" height="20"/>
					<textElement textAlignment="Center"/>
					<textFieldExpression class="java.lang.Long"><![CDATA[$V{vInternal}]]></textFieldExpression>
				</textField>
				<textField evaluationTime="Group" evaluationGroup="date">
					<reportElement mode="Opaque" x="100" y="0" width="130" height="20"/>
					<textElement textAlignment="Center"/>
					<textFieldExpression class="java.lang.Long"><![CDATA[$V{vOther}]]></textFieldExpression>
				</textField>
				<textField evaluationTime="Group" evaluationGroup="date">
					<reportElement mode="Opaque" x="330" y="0" width="100" height="20"/>
					<textElement textAlignment="Center"/>
					<textFieldExpression class="java.lang.Long"><![CDATA[$V{vIndikasi}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
	</group>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="87" splitType="Stretch">
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="556" height="15" backcolor="#CCCCCC"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Laporan Order Masuk]]></text>
			</staticText>
