<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptLpaMesinExt" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.4641000000000262"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="528"/>
	<subDataset name="dataset1">
		<parameter name="pId" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.value
from parameter a
where a.id::text = $P{pId}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<subDataset name="negative list">
		<parameter name="id_lpa" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select distinct y.value from lpa_umum_negatif_point x left join parameter y on x.id_parameter=y.id where x.id_lpa=$P{id_lpa}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<subDataset name="khusus">
		<parameter name="id_lpa" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select distinct y.value from lpa_umum_pertimbangan_khusus x left join parameter y on x.id_parameter=y.id where x.id_lpa=$P{id_lpa}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.nama_debitur,
        a.nama_perumahan,
        a.nama_cluster,
        a.posisi_lokasi_agunan,a.lokasi_fisik alamat,
        a.block,
        a.nomor,
        a.rt,
        a.rw,
        a.propinsi,
        a.kota,
        a.kecamatan,
        a.kelurahan,
        a.kode_pos,
        (select cb.kode_cabang from cabang cb where cb.id=a.id_app_cabang) as id_app_cabang,
        a.nomor_order,
        a.no_lpa,
        a.jenis_object,a.jenis_object_fisik,
        a.tanggal_order,
        a.tanggal_survey,
        a.dituju_ke,
        a.ditinjau,
        a.nama_contact, a.sla,
        (select x.nama from status_jaminan x where x.id = a.id_status_jaminan) status_jaminan,
        a.kategori_sla,
        --data
       	c.jenis,
       	c.merk,
       	c.type_model,
       	c.no_seri,
       	c.kegunaan,
       	c.kondisi,
	b.rangkaian_mesin,
       	b.waktu_pemakaian,
       	b.tempat_operasional,
       	b.kondisi_tempat,
       	b.lingkugnan_sekitar,
       	b.teknisi,
       	b.penyedia_suku_cadang,
       	c.no_invoice,
       	c.tanggal tgl_invoice,
       	c.pemilik,
       	c.tahun_pembuatan,
       	c.asal_pembuatan,
		c.rangkaian,
		(select count(lam.id) from lpa_mesin_lampiran lam where lam.id_lpa_mesin = b.id) jml_unit,
       	a.faktor_marketability,
       	(select distinct y.value from lpa_umum_negatif_point x inner join parameter y on x.id_parameter=y.id where x.id_lpa=a.id LIMIT 1) negativ_list,
(select distinct y.value from lpa_umum_pertimbangan_khusus x inner join parameter y on x.id_parameter=y.id where x.id_lpa=a.id LIMIT 1) perkembangan_khusus,
		b.nilai_doc_pasar,
		b.nilai_doc_likuidasi,
		b.nilai_fisik_pasar,
		b.nilai_fisik_likuidasi,
		b.nilai_doc_pasar_eks,
		b.nilai_doc_likuidasi_eks,
		b.nilai_fisik_pasar_eks,
		b.nilai_fisik_likuidasi_eks,
		a.deviasi_doc,
		a.deviasi_fisik,
		a.opini_internal,
		a.catatan_point,
		a.pembanding_1,
		a.pembanding_2,
		a.pembanding_3,
		(select y.closed_by from data_detail x inner join data_umum y on y.id = x.id_data_umum where x.id = a.id_data_detail) approve_by,
(select nama from person where user_id = e.closed_by ) approve_by,
e.closed_date approve_date,
(select nama from person where user_id = e.value_by ) value_by,
e.value_date,
jumlah_hari(e.submit_date, e.closed_date) hari_kerja,
(select count(lam.id) from lpa_mesin_lampiran lam where lam.id_lpa_mesin=b.id   ) count_lampiran,
a.FAKTOR_MARKET_CATATAN,
a.catatan_kesesuaian,
a.catatan_kewajaran_nilai, a.tanggal_penilaian,
b.beri_nilai_doc,
b.beri_nilai_fisik,
b.beri_nilai_doc_eks,
b.beri_nilai_fisik_eks, e.jenis_laporan
from lpa_umum a
left join data_umum e on a.id_data_umum = e.id
left join lpa_mesin b on b.id_lpa_umum = a.id
left join lpa_mesin_lampiran c on b.id = c.id_lpa_mesin
where a.id = $P{PIdLpaUmum}
LIMIT 1]]>
	</queryString>
