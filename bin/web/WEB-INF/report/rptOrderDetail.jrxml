<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptOrderDetail" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryWithPageHeaderAndFooter="true">
	<property name="ireport.zoom" value="1.3310000000000064"/>
	<property name="ireport.x" value="18"/>
	<property name="ireport.y" value="96"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<subDataset name="dataset1">
		<parameter name="PIdDataDetail" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select b.nama,
a.nama no_dokumen
from data_attact a
left join jenis_dokumen b on a.id_jenis_dokumen = b.id
where a.id_data_detail = $P{PIdDataDetail}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
		<field name="no_dokumen" class="java.lang.String"/>
	</subDataset>
	<subDataset name="user">
		<parameter name="pUserId" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select distinct a.nama, a.phone, a.hp
from person a
where a.user_id = $P{pUserId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
		<field name="phone" class="java.lang.String"/>
		<field name="hp" class="java.lang.String"/>
	</subDataset>
	<parameter name="PIdDataDetail" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select b.no_order,
c.nama status_nasabah,
d.nama status_jaminan,
b.kategori_appraisal || '-' || f.nama appraisal,
b.catatan,
b.nama,
h.nama dari_cabang,
b.nama_contact_person,
b.telp_contact_person,
e.nama jenis_objek_jaminan,
regexp_replace(a.alamat, '\r\n', ' ', 'g') alamat,
a.perumahan_apartment,
a.cluster_tower,
a.blok_lantai,
a.nomor,
a.rt,
a.rw,
a.kode_propinsi,
a.kode_kota,
a.kode_kecamatan,
a.kode_kelurahan,
a.kode_pos,
b.created_by nama_marketing,
b.created_date,
b.admin_by nama_admin,
b.admin_date,
jb.nama nm_dok,
da.nama no_dok
from data_detail a
left join data_umum b on a.id_data_umum = b.id
left join status_nasabah c on c.id = b.status_nasabah_id
left join status_jaminan d on d.id = b.status_jaminan_id
left join jenis_aktiva e on e.id = a.id_jenis_aktiva
left join jenis_appraisal f on f.id = b.jenis_appraisal_id
left join appraisal_cabang g on g.id = b.appraisal_cabang_id
left join cabang h on h.id = b.cabang_id
inner join data_attact da on da.id_data_detail = a.id
left join jenis_dokumen jb on da.id_jenis_dokumen = jb.id
where a.id =$P{PIdDataDetail}]]>
	</queryString>
	<field name="no_order" class="java.lang.String"/>
	<field name="status_nasabah" class="java.lang.String"/>
	<field name="status_jaminan" class="java.lang.String"/>
	<field name="appraisal" class="java.lang.String"/>
