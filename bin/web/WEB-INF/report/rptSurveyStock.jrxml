	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<subDataset name="negatif_point">
		<parameter name="PIdDataDetail" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select c.value
from survey_point a
inner join survey_negatif_point b on b.id_parameter = a.id
inner join parameter c on c.id = b.id_survey_point
where a.id_data_detail =$P{PIdDataDetail}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<subDataset name="pertimbangan_khusus">
		<parameter name="PIdDataDetail" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select c.value
from survey_point a
inner join survey_pertimbangan_khusus b on b.id_parameter = a.id
inner join parameter c on c.id = b.id_survey_point
where a.id_data_detail = $P{PIdDataDetail}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset1">
		<parameter name="PIdDataDetail" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.kontak_nama,
a.jenis_object,
a.kontak_telp,
a.alamat,
a.kondisi_lingkungan,
a.kondisi_bangunan,
a.keterangan
from survey_pembanding a
where a.id_data_detail = $P{PIdDataDetail}]]>
		</queryString>
		<field name="kontak_nama" class="java.lang.String"/>
		<field name="jenis_object" class="java.lang.String"/>
		<field name="kontak_telp" class="java.lang.String"/>
		<field name="alamat" class="java.lang.String"/>
		<field name="kondisi_lingkungan" class="java.lang.String"/>
		<field name="kondisi_bangunan" class="java.lang.String"/>
		<field name="keterangan" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset2">
		<parameter name="PIdDataDetail" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.kontak_nama,
a.jenis_object,
a.kontak_telp,
a.alamat,
a.kondisi_lingkungan,
a.kondisi_bangunan,
a.keterangan
from survey_pembanding a
where a.id_data_detail = $P{PIdDataDetail}]]>
		</queryString>
		<field name="kontak_nama" class="java.lang.String"/>
		<field name="jenis_object" class="java.lang.String"/>
		<field name="kontak_telp" class="java.lang.String"/>
		<field name="alamat" class="java.lang.String"/>
		<field name="kondisi_lingkungan" class="java.lang.String"/>
		<field name="kondisi_bangunan" class="java.lang.String"/>
		<field name="keterangan" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset1_1">
		<parameter name="pId" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.value
from parameter a
where a.id::text = $P{pId}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<parameter name="PIdDataDetail" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select b.nama,
b.nama_contact_person,
b.telp_contact_person,
a.waktu,
a.alamat,
a.keterangan_drop,
c.nama jenis_object_penilaian,
a.status_survey,
--data umum
d.hasil_survey,
d.id  no_survey,
d.lokasi,
d.dihuni,
d.ditinjau,
d.catatan_survey,
d.jenis_objek,
d.digunakan,
d.ditemui,
d.tanggal,
--data point
h.catatan,
e.jenis_persediaan,
e.asal_pembuatan,
e.penempatan_barang,
e.kemasan_barang,
e.kondisi_barang,
e.metode_pemeriksaan,
e.jumlah_persediaan,
e.kondisi_penyimpanan,
e.lingkungan_sekitar,
e.peralatan_gudang,
e.catatan catatan_stock
from data_detail a
left join data_umum b on a.id_data_umum = b.id
left join jenis_aktiva c on c.id = a.id_jenis_aktiva
left join survey_umum d on a.id = d.id_data_detail
left join survey_stock e on e.id_data_detail = a.id
left join survey_point h on h.id_data_detail = a.id
where a.id = $P{PIdDataDetail}
LIMIT 1]]>
	</queryString>
