<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptLpaKendaraan" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.771561000000027"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="672"/>
	<subDataset name="khusus">
		<parameter name="id_lpa" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select distinct y.value from lpa_umum_pertimbangan_khusus x left join parameter y on x.id_parameter=y.id where x.id_lpa=$P{id_lpa}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<subDataset name="negative list">
		<parameter name="id_lpa" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select distinct y.value from lpa_umum_negatif_point x left join parameter y on x.id_parameter=y.id where x.id_lpa=$P{id_lpa}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select distinct
        --data
        c.jenis_kendaraan,
        c.merk,
	c.model,
        c.silinder isi_slinder,
        c.tahun_pembuatan,
        c.asal_pembuatan,
        c.warna,
        c.no_polisi,
        c.no_rangka,
        c.no_mesin,
        c.bahan_bakar,
        c.penggunaan,
        c.pemakaian,
        c.kilometer,
        c.body,
        c.bumper,
        c.cat,
        c.eksterior,
        c.interior,
        c.mesin,
        c.ban,
        c.pajak_stnk,
        c.jatuh_tempo_stnk,
        c.jatuh_tempo_pajak,
        c.no_faktur,
        c.no_bpkb,
        c.tanggal_terbit_bpkb,
        c.atas_nama_bpkn,
        c.alamat_bpkb,
        a.faktor_marketability,
        (select distinct y.value from lpa_umum_negatif_point x inner join parameter y on x.id_parameter=y.id where x.id_lpa=a.id LIMIT 1) negativ_list,
		(select distinct y.value from lpa_umum_pertimbangan_khusus x inner join parameter y on x.id_parameter=y.id where x.id_lpa=a.id LIMIT 1) perkembangan_khusus,
		b.total_doc doc_pasar,
		b.likuidasi_doc doc_likuidasi,
		b.total_fisik fisik_pasar,
		b.likuidasi_fisik fisik_likuidasi,
		a.catatan_point,
		a.pembanding_1,
		a.pembanding_2,
		a.pembanding_3,
		(select y.closed_by from data_detail x inner join data_umum y on y.id = x.id_data_umum where x.id = a.id_data_detail) approve_by,
(select nama from person where user_id = e.closed_by ) approve_by,
e.closed_date approve_date,
(select nama from person where user_id = e.value_by ) value_by,
e.value_date,
--header
a.nama_debitur,
        a.nama_perumahan,
        a.nama_cluster,
        a.posisi_lokasi_agunan,regexp_replace(a.lokasi_fisik, '\r\n', ' ', 'g') alamat,
        a.block,
        a.nomor,
        a.rt,
        a.rw,
        a.propinsi,
        a.kota,
        a.kecamatan,
        a.kelurahan,
        a.kode_pos,
        (select cb.nama from cabang cb where cb.id=e.cabang_id) as id_app_cabang,
        a.nomor_order,
        a.no_lpa,
        a.jenis_object,a.jenis_object_fisik,
        a.tanggal_order,
        a.tanggal_survey,
        a.dituju_ke,
        a.ditinjau,
        a.nama_contact, a.sla,
        (select x.nama from status_jaminan x where x.id = a.id_status_jaminan) status_jaminan,
        a.kategori_sla,
jumlah_hari(e.submit_date, e.closed_date) hari_kerja,
(select count(item.id) from lpa_kendaraan_item item where item.id_lpa_kendaraan=b.id) count_lampiran,
a.FAKTOR_MARKET_CATATAN,
b.beri_nilai_doc,
b.beri_nilai_fisik,
b.beri_nilai_doc_eks,
b.beri_nilai_fisik_eks, e.jenis_laporan
from lpa_umum a
left join data_umum e on a.id_data_umum = e.id
left join lpa_kendaraan b on a.id=b.id_lpa_umum
left join lpa_kendaraan_item c on b.id=c.id_lpa_kendaraan
where a.id = $P{PIdLpaUmum}
LIMIT 1]]>
	</queryString>
