<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptFormatLpaInt" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.650000000000001"/>
	<property name="ireport.x" value="347"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select a.no_lpa,
a.nama_debitur,
a.lokasi_fisik,
c.nomor_imb,
c.tanggal_imb,
c.ijin_sesuai_imb,
c.jumlah_lantai,
c.luas_bangunan
from lpa_umum a
left join lpa_tanah_bangunan b on a.id = b.id_lpa_umum
left join lpa_doc_bangunan c on c.id_lpa_umum = b.id
where a.id = $P{PIdLpaUmum}]]>
	</queryString>
	<field name="no_lpa" class="java.lang.String"/>
	<field name="nama_debitur" class="java.lang.String"/>
	<field name="lokasi_fisik" class="java.lang.String"/>
	<field name="nomor_imb" class="java.lang.String"/>
	<field name="tanggal_imb" class="java.sql.Timestamp"/>
	<field name="ijin_sesuai_imb" class="java.lang.String"/>
	<field name="jumlah_lantai" class="java.lang.Double"/>
	<field name="luas_bangunan" class="java.lang.Double"/>
	<variable name="total_luas" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{luas_bangunan}]]></variableExpression>
	</variable>
