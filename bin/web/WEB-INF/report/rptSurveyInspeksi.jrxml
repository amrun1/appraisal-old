<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptLpaInspeksi" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.3636363636363684"/>
	<property name="ireport.x" value="10"/>
	<property name="ireport.y" value="571"/>
	<subDataset name="dataset1">
		<parameter name="pId" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.value
from parameter a
where a.id::text = $P{pId}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<parameter name="PIdDataDetail" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select b.nama,
b.nama_contact_person,
b.telp_contact_person,
a.waktu,
a.alamat,
a.keterangan_drop,
c.nama jenis_object_penilaian,
a.status_survey,
b.submit_date tanggal_order,
a.kode_propinsi propinsi,
a.kode_kota kota,
a.kode_kecamatan kecamatan,
a.kode_kelurahan kelurahan,
a.kode_pos,
--data umum
d.hasil_survey,
d.id  no_survey,
d.lokasi,
d.dihuni,
d.ditinjau,
d.catatan_survey,
d.jenis_objek,
d.digunakan,
d.ditemui,
d.tanggal,
--survey inspekksi
e.*,
(select count(*) from survey_inspeksi_item item where item.id_survey_inspeksi = e.id and item.tipe = 'Goods' ) count_barang_jadi,
(select item.nama from survey_inspeksi_item item where item.id_survey_inspeksi = e.id and item.tipe = 'Goods' LIMIT 1 ) uraian_barang_jadi,
(select item.total_doc from survey_inspeksi_item item where item.id_survey_inspeksi = e.id and item.tipe = 'Goods' LIMIT 1 ) doc_barang_jadi,
(select item.total_fisik from survey_inspeksi_item item where item.id_survey_inspeksi = e.id and item.tipe = 'Goods' LIMIT 1 ) fisik_barang_jadi,
(select count(*) from survey_inspeksi_item item where item.id_survey_inspeksi = e.id and item.tipe = 'Half_Goods' ) count_barang_setengah_jadi,
(select item.nama from survey_inspeksi_item item where item.id_survey_inspeksi = e.id and item.tipe = 'Half_Goods' LIMIT 1 ) uraian_barang_setengah_jadi,
(select item.total_doc from survey_inspeksi_item item where item.id_survey_inspeksi = e.id and item.tipe = 'Half_Goods' LIMIT 1 ) doc_barang_setengah_jadi,
(select item.total_fisik from survey_inspeksi_item item where item.id_survey_inspeksi = e.id and item.tipe = 'Half_Goods' LIMIT 1 ) fisik_barang_setengah_jadi,
(select count(*) from survey_inspeksi_item item where item.id_survey_inspeksi = e.id and item.tipe = 'Raw_Materials' ) count_bahan_baku,
(select item.nama from survey_inspeksi_item item where item.id_survey_inspeksi = e.id and item.tipe = 'Raw_Materials' LIMIT 1 ) uraian_bahan_baku,
(select item.total_doc from survey_inspeksi_item item where item.id_survey_inspeksi = e.id and item.tipe = 'Raw_Materials' LIMIT 1 ) doc_bahan_baku,
(select item.total_fisik from survey_inspeksi_item item where item.id_survey_inspeksi = e.id and item.tipe = 'Raw_Materials' LIMIT 1 ) fisik_bahan_baku,
(select nama from person where user_id = b.closed_by ) approve_by,
b.closed_date approve_date,
(select nama from person where user_id = b.value_by ) value_by,
b.value_date,
(select nama from person where user_id = b.created_by ) rm,
h.catatan catatan_point
from data_detail a
left join data_umum b on a.id_data_umum = b.id
left join jenis_aktiva c on c.id = a.id_jenis_aktiva
left join survey_umum d on a.id = d.id_data_detail
left join survey_inspeksi e on e.id_data_detail = a.id
left join survey_inspeksi_item item on item.id_survey_inspeksi = e.id
left join survey_point h on h.id_data_detail = a.id
where a.id = $P{PIdDataDetail}
LIMIT 1]]>
	</queryString>
