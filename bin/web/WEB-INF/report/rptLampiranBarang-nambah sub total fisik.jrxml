				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["LAMPIRAN PERSEDIAAN "+($P{PTypeBarang}.equals( "Goods" )? "BARANG JADI" :($P{PTypeBarang}.equals( "Raw_Materials" )?"BAHAN BAKU":"BARANG SETENGAH JADI"))+"\nLAPORAN INSPEKSI ATAS STOCK/PERSEDIAAN"]]></textFieldExpression>
