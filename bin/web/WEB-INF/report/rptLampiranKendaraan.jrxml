	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.no_lpa,
a.nama_debitur,
a.lokasi_fisik,
c.merk,
c.model,
c.silinder,
c.asal_pembuatan,
c.tahun_pembuatan,
c.warna,
c.no_polisi,
c.no_rangka,
c.no_mesin,
c.bahan_bakar,
c.no_bpkb,
c.pajak_stnk,
c.kilometer,
c.body,
c.interior,
c.mesin,
c.nilai_dokumen,
c.nilai_pasar,
c.penggunaan
from lpa_umum a
left join lpa_kendaraan b on a.id=b.id_lpa_umum
left join lpa_kendaraan_item c on b.id=c.id_lpa_kendaraan
where a.id = $P{PIdLpaUmum}]]>
	</queryString>
