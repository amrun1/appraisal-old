	<field name="group_val" class="java.lang.String"/>
	<field name="val_type" class="java.lang.String"/>
	<field name="apr_ext_date" class="java.sql.Timestamp"/>
	<field name="apr_int_date" class="java.sql.Timestamp"/>
	<field name="val_date" class="java.sql.Timestamp"/>
	<field name="val_name" class="java.lang.String"/>
