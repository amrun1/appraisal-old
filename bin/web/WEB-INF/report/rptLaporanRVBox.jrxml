<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptFormatLpaInt" pageWidth="759" pageHeight="910" whenNoDataType="AllSectionsNoDetail" columnWidth="719" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.4641000000000144"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="833"/>
	<subDataset name="dataset2">
		<parameter name="idbv" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="fs" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select * from lpabv_fasilitas where lpabv_id = $P{idbv} and fasilitas=$P{fs}]]>
		</queryString>
		<field name="lpabv_id" class="java.lang.Long"/>
		<field name="fasilitas" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset1">
		<parameter name="idbv" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="nama" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select * from lparv_fotopada where lparv_id = $P{idbv} and fotopada = $P{nama}]]>
		</queryString>
		<field name="lparv_id" class="java.lang.Long"/>
		<field name="fotopada" class="java.lang.String"/>
	</subDataset>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select b.id id_rv, a.no_lpa,
a.nama_contact,
a.nama_debitur,
a.nama_perumahan,
regexp_replace(a.lokasi_fisik, '\r\n', ' ', 'g') lokasi_fisik,
a.kota,
a.kode_pos,
a.ditinjau nama_surveyor,
e.submit_date tanggal_order,
a.tanggal_survey,
a.tanggal_terima_dari_eks,
b.lokasi_ditemukan,
b.sudah_pindah,
b.s1_ditemukan,
b.s1_nama,
b.s1_kelamin,
b.s1_hubungan,
b.s1_kooperatif,
--s2
b.s2_ditemukan,
b.s2_nama,
b.s2_kelamin,
b.s2_hubungan,
b.s2_kenal,
b.s2_kooperatif,
--s2
b.s3_ditemukan,
b.s3_nama,
b.s3_kelamin,
b.s3_hubungan,
b.s3_kenal,
b.s3_kooperatif,
--
b.diterima_di,
b.lama_penempatan,
b.lingkungan_sekitar,
b.luas_bangunan,
b.luas_tanah,
b.jenis_bangunan,
regexp_replace(b.info_s1, '\r\n', ' ', 'g') info_s1,
regexp_replace(b.info_s2, '\r\n', ' ', 'g') info_s2,
regexp_replace(b.info_s3, '\r\n', ' ', 'g') info_s3,
regexp_replace(b.note, '\r\n', ' ', 'g') note,
b.umur,
b.kondisi_rumah,
b.penghuni,
b.dikenal_nama_sama,
b.didatangi_debt_collector,
b.status_kepemilikan,
b.no_telepon,
b.ada_car_port,
b.ada_garasi,b.vendor,
(select nama from person where user_id = e.closed_by ) approve_by,
e.closed_date approve_date,
(select nama from person where user_id = e.value_by ) value_by,
e.value_date,
b.nama_panggilan,
b.lokasi_objek_jam
from lpa_umum a
inner join lpa_rv b on b.id_lpa_umum = a.id
left join data_umum e on a.id_data_umum = e.id
where a.id=$P{PIdLpaUmum}]]>
	</queryString>
