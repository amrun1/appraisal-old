	<property name="ireport.zoom" value="1.3636363636363646"/>
	<property name="ireport.x" value="310"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PImagePath" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.no_lpa,
a.nama_debitur,
a.lokasi_fisik,
d.nama jenis_dokumen,
c.nama_dokumen no_dokumen,
c.nama_jalan,
c.surat_ukur,
c.tanggal_akhir_hak,
c.nama_pemegang_hak,
c.luas_tanah
from lpa_umum a
left join lpa_tanah_bangunan b on a.id = b.id_lpa_umum
left join lpa_doc_tanah c on b.id = c.id_lpa_lnb
inner join jenis_dokumen d on d.id = c.id_jenis_dokumen
where a.id = $P{PIdLpaUmum}]]>
	</queryString>
	<field name="no_lpa" class="java.lang.String"/>
	<field name="nama_debitur" class="java.lang.String"/>
	<field name="lokasi_fisik" class="java.lang.String"/>
	<field name="jenis_dokumen" class="java.lang.String"/>
	<field name="no_dokumen" class="java.lang.String"/>
	<field name="nama_jalan" class="java.lang.String"/>
	<field name="surat_ukur" class="java.lang.String"/>
	<field name="tanggal_akhir_hak" class="java.sql.Timestamp"/>
	<field name="nama_pemegang_hak" class="java.lang.String"/>
	<field name="luas_tanah" class="java.lang.Double"/>
	<variable name="total_luas" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{luas_tanah}]]></variableExpression>
	</variable>
