	<field name="bisnis" class="java.lang.String"/>
	<field name="object_penilaian" class="java.lang.String"/>
	<field name="lokasi_agunan" class="java.lang.String"/>
	<field name="kode_kota" class="java.lang.String"/>
	<field name="kode_propinsi" class="java.lang.String"/>
	<field name="kode_pos" class="java.lang.String"/>
	<field name="tanggal_order" class="java.sql.Timestamp"/>
	<field name="tanggal_survey" class="java.sql.Timestamp"/>
	<field name="value_date" class="java.sql.Timestamp"/>
	<field name="sla_admin" class="java.lang.Double"/>
	<field name="sla_valuer" class="java.lang.Double"/>
	<field name="sla_surveyor" class="java.lang.Double"/>
	<field name="sla_approval" class="java.lang.Double"/>
	<field name="total_sla" class="java.lang.Double"/>
	<field name="luas_tanah" class="java.lang.Double"/>
	<field name="luas_bangunan" class="java.lang.Double"/>
	<field name="total_sesuai_doc" class="java.math.BigDecimal"/>
	<field name="total_sesuai_fisik" class="java.math.BigDecimal"/>
	<field name="harga_tanah" class="java.math.BigDecimal"/>
	<field name="harga_bangunan" class="java.math.BigDecimal"/>
	<field name="jenis_lpa" class="java.lang.String"/>
	<field name="jenis_appraisal_id" class="java.lang.Long"/>
	<field name="jenis_laporan" class="java.lang.String"/>
	<field name="submit_date" class="java.sql.Timestamp"/>
	<field name="closed_date" class="java.sql.Timestamp"/>
	<field name="nama_pic" class="java.lang.String"/>
	<field name="hari_kerja" class="java.lang.Double"/>
	<field name="jenis_app" class="java.lang.String"/>
	<field name="hari_kerja_appraisal" class="java.lang.Double"/>
