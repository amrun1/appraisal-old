	<subDataset name="jenisAktiva" uuid="1a6607f5-76f4-47f9-b740-217a1e732e38">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from jenis_aktiva
where id =$P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<parameter name="pCabangApppraisal" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pPosisi" class="java.lang.String">
