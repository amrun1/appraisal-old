	<parameter name="pTimUser" class="java.lang.Integer"/>
	<parameter name="pCabang" class="java.lang.Long"/>
	<parameter name="pCabangDesk" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
id,no_order,no_lpa,nama_debitur,ditinjau,value_by,closed_by,status_jaminan_id,created_by,cabang,bisnis,object_penilaian,lokasi_agunan,kode_kota,kode_propinsi,kode_pos,tanggal_order,tanggal_survey,value_date,
	coalesce((f).jml_sla_admin,0) sla_admin,
	--sla valuer
	coalesce((f).jml_sla_valuer,0) sla_valuer,
	--sla surveyor
	coalesce((f).jml_sla_surveyor,0) sla_surveyor,
	--sla approval
	coalesce((f).jml_sla_approval,0) sla_approval,
	--total sla
	coalesce((f).jml_sla_admin,0)+coalesce((f).jml_sla_valuer,0)+coalesce((f).jml_sla_surveyor,0)+coalesce((f).jml_sla_approval,0) total_sla,
luas_tanah,luas_bangunan,total_sesuai_doc,total_sesuai_fisik,harga_tanah,harga_bangunan,jenis_lpa,jenis_appraisal_id,jenis_laporan,submit_date,closed_date,nama_pic,
CEIL((coalesce((f).jml_sla_admin,0)+coalesce((f).jml_sla_valuer,0)+coalesce((f).jml_sla_surveyor,0)+coalesce((f).jml_sla_approval,0))/24) as hari_kerja,
CEIL((coalesce((f).jml_sla_valuer,0)+coalesce((f).jml_sla_surveyor,0)+coalesce((f).jml_sla_approval,0))/24) as hari_kerja_appraisal,
jenis_app
from
(select f_sla_hitung(c.id) as f,
	c.id,
	c.no_order,
    a.no_lpa,
	a.nama_debitur,
	a.ditinjau,
	(select p.nama from person p where p.user_id = c.value_by) value_by,
	(select p.nama from person p where p.user_id = c.closed_by) closed_by,
	(select nama from status_jaminan where id = c.status_jaminan_id) status_jaminan_id,
	(select p.nama from person p where p.user_id = c.created_by) created_by,
	c.appraisal_cabang_id cabang,
	(select nama from cabang where id = c.cabang_id) bisnis,
	(select nama from jenis_aktiva where id = b.id_jenis_aktiva) object_penilaian,
	b.alamat lokasi_agunan,
	b.kode_kota,
	b.kode_propinsi,
	b.kode_pos,
	c.submit_date tanggal_order,
	a.tanggal_survey,
	c.value_date,
	d.total_luas_tanah_doc luas_tanah,
	d.luas_bangunan,
	case when d.total_doc_eks is not null or d.total_sesuai_doc is not null then (case when d.total_doc_eks is not null and d.total_doc_eks > 0 then d.total_doc_eks else  d.total_sesuai_doc end)
		when f.nilai_doc_pasar is not null or f.nilai_doc_pasar_eks is not null then (case when f.nilai_doc_pasar_eks is not null and f.nilai_doc_pasar_eks > 0 then f.nilai_doc_pasar_eks else  f.nilai_doc_pasar end)
		when g.total_doc is not null or g.total_doc_eks is not null then (case when g.total_doc_eks is not null and g.total_doc_eks > 0 then g.total_doc_eks else  g.total_doc end)
		when h.nilai_dokumen is not null or h.nilai_dokumen_eks is not null then (case when h.nilai_dokumen_eks is not null and h.nilai_dokumen_eks > 0 then h.nilai_dokumen_eks else  h.nilai_dokumen end)
		else (case when e.nilai_doc_pasar_eks is not null and e.nilai_doc_pasar_eks > 0 then e.nilai_doc_pasar_eks else  e.nilai_doc_pasar end) end total_sesuai_doc,
	case when d.total_fisik_eks is not null or d.total_sesuai_fisik is not null then (case when d.total_fisik_eks is not null and d.total_fisik_eks > 0 then d.total_fisik_eks else  d.total_sesuai_fisik end)
		when f.nilai_fisik_pasar is not null or f.nilai_fisik_pasar_eks is not null then (case when f.nilai_fisik_pasar_eks is not null and f.nilai_fisik_pasar_eks > 0 then f.nilai_fisik_pasar_eks else  f.nilai_fisik_pasar end)
		when g.total_fisik is not null or g.total_fisik_eks is not null then (case when g.total_fisik_eks is not null and g.total_fisik_eks > 0 then g.total_fisik_eks else  g.total_fisik end)
		when h.nilai_fisik is not null or h.nilai_fisik_eks is not null then (case when h.nilai_fisik_eks is not null and h.nilai_fisik_eks > 0 then h.nilai_fisik_eks else  h.nilai_fisik end)
		else (case when e.nilai_fisik_pasar_eks is not null and e.nilai_fisik_pasar_eks > 0 then e.nilai_fisik_pasar_eks else  e.nilai_fisik_pasar end) end total_sesuai_fisik,
	case when d.nilai_fisik_1_eks is not null and d.nilai_fisik_1_eks > 0 then d.nilai_fisik_1_eks else  d.nilai_fisik_1 end harga_tanah,
	case when d.nilai_fisik_2_eks is not null and d.nilai_fisik_2_eks > 0 then d.nilai_fisik_2_eks else  d.nilai_fisik_2 end harga_bangunan,
	c.kategori_appraisal jenis_lpa,
	c.jenis_appraisal_id,
	c.jenis_laporan,
	c.submit_date,
	c.closed_date,
	b.nama_pic,
	(select nama from jenis_appraisal x where x.id = c.jenis_appraisal_id) jenis_app
	from lpa_umum a
	left join data_detail b on a.id_data_detail = b.id
	left join data_umum c on c.id = b.id_data_umum
	left join lpa_tanah_bangunan d on d.id_lpa_umum = a.id
	left join lpa_mesin e on e.id_lpa_umum = a.id
	left join lpa_kapal f on f.id_lpa_umum = a.id
	left join lpa_kendaraan g on g.id_lpa_umum = a.id
	left join lpa_stock h on h.id_lpa_umum = a.id
	-- left join v_sla_hitung i on i.id_umum = c.id
	where c.appraisal_cabang_id=$P{pCabangApppraisal}
	and coalesce(c.closed_date, c.value_date) between $P{pSubmitDate} and $P{pCloseDate}
	and c.submit_date is not null
	and c.posisi = 'CLOSE'
	order by c.closed_date asc
) dt]]>
	</queryString>
	<field name="id" class="java.lang.Long"/>
	<field name="no_order" class="java.lang.String"/>
	<field name="no_lpa" class="java.lang.String"/>
	<field name="nama_debitur" class="java.lang.String"/>
	<field name="ditinjau" class="java.lang.String"/>
	<field name="value_by" class="java.lang.String"/>
	<field name="closed_by" class="java.lang.String"/>
