	<subDataset name="dataset3" uuid="3c99bbd5-e1e4-43b2-83e2-8dd0c18fd146">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from appraisal_cabang
where id = $P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset4" uuid="fae18133-9d21-4fdb-a01f-417c78ac3744">
		<parameter name="pUserId" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select distinct(a.nama) as nama
from person a,
person_roles b
where a.user_id = b.user_id
and b.person_level = 'MARKETING'
and a.user_id = $P{pUserId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<parameter name="pSubmitDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pCloseDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pCabangId" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pAppraisalCabangId" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select b.no_order,
b.nama nasabah,
(select nama from status_jaminan where id =b.status_jaminan_id) status_jaminan_id,
b.created_by,
b.cabang_id,
a.id_jenis_aktiva,
a.alamat,
b.appraisal_cabang_id,
b.posisi,
b.jenis_appraisal_id,
(select case id when -1 then b.kategori_appraisal else nama end nama from jenis_appraisal where id = b.jenis_appraisal_id) kategori,
c.nama
from data_detail a
left join data_umum b on a.id_data_umum = b.id
left join (select case x.id when -1 then y.kategori_appraisal else x.nama end nama, x.id id, y.id id_umum from jenis_appraisal x, data_umum y where x.id = y.jenis_appraisal_id and y.kategori_appraisal is not null) c on c.id_umum = b.id
where b.cabang_id = $P{pCabangId}
and b.appraisal_cabang_id = $P{pAppraisalCabangId}
and b.kategori_appraisal is not null
and date(b.submit_date) between $P{pSubmitDate} and $P{pCloseDate}
and b.posisi NOT IN  ('User_TL', 'DROP')
order by c.nama asc]]>
	</queryString>
	<field name="no_order" class="java.lang.String"/>
	<field name="nasabah" class="java.lang.String"/>
	<field name="status_jaminan_id" class="java.lang.String"/>
	<field name="created_by" class="java.lang.String"/>
	<field name="cabang_id" class="java.lang.Long"/>
	<field name="id_jenis_aktiva" class="java.lang.Long"/>
	<field name="alamat" class="java.lang.String"/>
	<field name="appraisal_cabang_id" class="java.lang.Long"/>
	<field name="posisi" class="java.lang.String"/>
	<field name="jenis_appraisal_id" class="java.lang.Long"/>
	<field name="kategori" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
