	<subDataset name="dataset1" uuid="9a391360-0531-4aab-90c9-61bfab83e9ac">
		<parameter name="idbv" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select * from lpabv_fotopada where lpabv_id = $P{idbv}]]>
		</queryString>
		<field name="lpabv_id" class="java.lang.Long"/>
		<field name="fotopada" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset2" uuid="0ccdc6bc-2433-48ee-b0d5-3d309a244144">
		<parameter name="idbv" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select * from lpabv_fasilitas where lpabv_id = $P{idbv}]]>
		</queryString>
		<field name="lpabv_id" class="java.lang.Long"/>
		<field name="fasilitas" class="java.lang.String"/>
