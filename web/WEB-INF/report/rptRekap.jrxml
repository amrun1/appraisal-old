	</subDataset>
	<subDataset name="dataset3" uuid="d003bb26-6d9e-4ef2-8f42-5ec8ead3f79d">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from appraisal_cabang
where id = $P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset4" uuid="3a84c6d1-89c6-4a36-8587-c8d00d360aaf">
		<parameter name="pUserId" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select distinct(a.nama) as nama
from person a,
person_roles b
where a.user_id = b.user_id
and b.person_level = 'MARKETING'
and a.user_id = $P{pUserId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<parameter name="pSubmitDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pCloseDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pCabangId" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pAppraisalCabangId" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select count(c.nama), c.nama, date(b.submit_date), c.id
from data_detail a
left join data_umum b on a.id_data_umum = b.id
left join (select case x.id when 2 then y.kategori_appraisal else x.nama end nama, x.id id, y.id id_umum from jenis_appraisal x, data_umum y where x.id = y.jenis_appraisal_id and y.kategori_appraisal is not null) c on c.id_umum = b.id
where b.cabang_id = $P{pCabangId}
and b.appraisal_cabang_id = $P{pAppraisalCabangId}
and b.kategori_appraisal is not null
and date(b.submit_date) between $P{pSubmitDate} and $P{pCloseDate}
and b.posisi <> 'User_TL'
group by c.nama,
 date(b.submit_date), c.id
order by date(b.submit_date) asc]]>
	</queryString>
	<field name="count" class="java.lang.Long"/>
	<field name="nama" class="java.lang.String"/>
	<field name="date" class="java.sql.Date"/>
	<field name="id" class="java.lang.Long"/>
	<variable name="vOther" class="java.lang.Long" resetType="Group" resetGroup="date" calculation="Sum">
		<variableExpression><![CDATA[$F{id}!= 2 && $F{id}!= 50 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vEksternal" class="java.lang.Long" resetType="Group" resetGroup="date" calculation="Sum">
		<variableExpression><![CDATA[!$F{nama}.equals( "Internal" ) && $F{id}!= 50 && $F{id}!= 1050 && $F{id}!= 1051 && $F{id}!= 1052 && $F{id}!= 4 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vInternal" class="java.lang.Long" resetType="Group" resetGroup="date" calculation="Sum">
		<variableExpression><![CDATA[!$F{nama}.equals( "Eksternal" ) && $F{id}!= 50 && $F{id}!= 1050 && $F{id}!= 1051 && $F{id}!= 1052 && $F{id}!= 4  ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vIndikasi" class="java.lang.Long" resetType="Group" resetGroup="date" calculation="Sum">
		<variableExpression><![CDATA[$F{id}!= 2 && $F{id}!= 1050 && $F{id}!= 1051 && $F{id}!= 1052 && $F{id}!= 4 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vOtherTotal" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{id}!= 2 && $F{id}!= 50 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vEksternalTotal" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[!$F{nama}.equals( "Internal" ) && $F{id}!= 50 && $F{id}!= 1050 && $F{id}!= 1051 && $F{id}!= 1052 && $F{id}!= 4  ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vInternalTotal" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[!$F{nama}.equals( "Eksternal" ) && $F{id}!= 50 && $F{id}!= 1050 && $F{id}!= 1051 && $F{id}!= 1052 && $F{id}!= 4  ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vIndikasiTotal" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{id}!= 2 && $F{id}!= 1050 && $F{id}!= 1051 && $F{id}!= 1052 && $F{id}!= 4 ? $F{count} :0]]></variableExpression>
	</variable>
