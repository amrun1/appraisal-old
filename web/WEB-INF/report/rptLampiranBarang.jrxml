	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<parameter name="PImagePath" class="java.lang.String"/>
	<parameter name="PTypeBarang" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.no_lpa,
a.nama_debitur,
a.lokasi_fisik,
c.nama, c.total_doc, c.total_fisik, b.total_goods, b.total_halfgoods, b.total_rawmaterial, b.total_goods_fisik, b.total_halfgoods_fisik, b.total_rawmaterial_fisik
from lpa_umum a
left join lpa_inspeksi b on b.id_lpa_umum = a.id
left join lpa_inspeksi_item c on c.id_lpa_inspeksi = b.id
where a.id = $P{PIdLpaUmum}
and c.tipe = $P{PTypeBarang}]]>
	</queryString>
	<field name="no_lpa" class="java.lang.String"/>
	<field name="nama_debitur" class="java.lang.String"/>
