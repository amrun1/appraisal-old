	<field name="total_halfgoods_fisik" class="java.lang.String"/>
	<field name="total_rawmaterial_fisik" class="java.lang.String"/>
	<variable name="totalDokumen" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[Integer.valueOf($F{total_doc})]]></variableExpression>
	</variable>
	<variable name="totalFisik" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[Integer.valueOf($F{total_fisik})]]></variableExpression>
	</variable>
