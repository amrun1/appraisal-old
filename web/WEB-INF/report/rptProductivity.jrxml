	<subDataset name="Bisnis" uuid="debe4af4-c922-4cd1-9901-2daaa1407c80">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from cabang
where id = $P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="Cabang" uuid="70307438-da37-40db-afd9-272b390b09e9">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from appraisal_cabang
where id = $P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="JenisAppraisal" uuid="5861707a-19d8-42a5-afa4-62f2e9723ef3">
		<parameter name="id" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="id_umum" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select case when b.kategori_appraisal = 'Internal' then 'Internal' when b.kategori_appraisal = 'Eksternal' then 'Eksternal' else a.nama end nama
from jenis_appraisal a
left outer join data_umum b on a.id=b.jenis_appraisal_id
where a.id = $P{id}
and b.id = $P{id_umum}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="user" uuid="27702575-5df0-419b-b824-845458202952">
		<parameter name="pUserId" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.nama
from person a
--,person_roles b
where a.user_id = $P{pUserId}
--and a.user_id = b.user_id]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="statusJaminan" uuid="e230c615-a685-4b36-918b-912091b71969">
