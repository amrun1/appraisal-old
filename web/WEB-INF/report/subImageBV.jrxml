<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptFormatLpaInt" columnCount="2" printOrder="Horizontal" pageWidth="759" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="379" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.1961500000000034"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="net.sf.jasperreports.engine.util.JRImageLoader" value="true"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select a.no_lpa,
a.nama_debitur,
a.lokasi_fisik, b.id_laporan_dokumen,
lo_get(b.image) img, b.nama ket,
(select nama from jenis_kategori where kode = a.kategori_aktiva) kategori
from lpa_umum a
left outer join (
select b.id_laporan_dokumen, b.image, c.nama, b.id_survey_umum, b.id_lpa
from survey_image b
	left outer join jenis_laporan_dokumen c on b.id_laporan_dokumen = c.id
where c.form_survey = TRUE
) as b
	on a.id_survey = b.id_survey_umum or a.id = b.id_lpa
where a.id =$P{PIdLpaUmum}
order by B.nama]]>
	</queryString>
	<field name="no_lpa" class="java.lang.String"/>
	<field name="nama_debitur" class="java.lang.String"/>
	<field name="lokasi_fisik" class="java.lang.String"/>
	<field name="id_laporan_dokumen" class="java.lang.Long"/>
	<field name="img" class="java.io.InputStream"/>
	<field name="ket" class="java.lang.String"/>
	<field name="kategori" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="196" splitType="Stretch">
			<frame>
				<reportElement x="30" y="3" width="284" height="192"/>
				<box>
					<topPen lineWidth="1.0"/>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
					<rightPen lineWidth="1.0"/>
				</box>
				<image hAlign="Center" vAlign="Middle">
					<reportElement key="image" x="0" y="0" width="282" height="170"/>
					<imageExpression class="java.io.InputStream"><![CDATA[$F{img}]]></imageExpression>
				</image>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="170" width="282" height="20"/>
					<textElement textAlignment="Center" verticalAlignment="Middle"/>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{ket}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band splitType="Stretch"/>
	</pageFooter>
</jasperReport>
