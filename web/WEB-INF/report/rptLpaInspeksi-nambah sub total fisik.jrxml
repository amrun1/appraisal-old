	<subDataset name="dataset1" uuid="34701ab3-b2c6-4c67-b8ff-98f46ab7240b">
		<parameter name="pId" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.value
from parameter a
where a.id::text = $P{pId}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select distinct a.nama_debitur,
        a.nama_perumahan,
        a.nama_cluster,
        a.posisi_lokasi_agunan,
regexp_replace(a.lokasi_fisik, '\r\n', ' ', 'g') alamat,
a.jenis_object_fisik,
a.sla,
        a.block,
        a.nomor,
        a.rt,
        a.rw,
        a.propinsi,
        a.kota,
        a.kecamatan,
        a.kelurahan,
        a.kode_pos,
        (select cb.nama from cabang cb where cb.id=e.cabang_id) as id_app_cabang,
        a.nomor_order,
        a.no_lpa,
        a.jenis_object,
        e.submit_date tanggal_order,
        a.tanggal_survey,
        a.dituju_ke,
        a.ditinjau,
        a.nama_contact,
        (select x.nama from status_jaminan x where x.id = a.id_status_jaminan) status_jaminan,
        a.kategori_sla,
a.faktor_marketability,
a.catatan_point,
a.pembanding_1,
a.pembanding_2,
a.pembanding_3,
(select nama from person where user_id = e.closed_by ) approve_by,
e.closed_date approve_date,
(select nama from person where user_id = e.value_by ) value_by,
e.value_date,
a.deviasi_doc,
a.deviasi_fisik,
a.opini_internal,
a.catatan_point,
jumlah_hari(e.submit_date, e.closed_date) hari_kerja,
a.FAKTOR_MARKET_CATATAN,
a.catatan_kesesuaian,
a.catatan_kewajaran_nilai,
e.jenis_laporan, b.*,
(select count(*) from lpa_inspeksi_item item where item.id_lpa_inspeksi = b.id and item.tipe = 'Goods' ) count_barang_jadi,
(select item.nama from lpa_inspeksi_item item where item.id_lpa_inspeksi = b.id and item.tipe = 'Goods' LIMIT 1 ) uraian_barang_jadi,
(select item.total_doc from lpa_inspeksi_item item where item.id_lpa_inspeksi = b.id and item.tipe = 'Goods' LIMIT 1 ) doc_barang_jadi,
(select item.total_fisik from lpa_inspeksi_item item where item.id_lpa_inspeksi = b.id and item.tipe = 'Goods' LIMIT 1 ) fisik_barang_jadi,
(select count(*) from lpa_inspeksi_item item where item.id_lpa_inspeksi = b.id and item.tipe = 'Half_Goods' ) count_barang_setengah_jadi,
(select item.nama from lpa_inspeksi_item item where item.id_lpa_inspeksi = b.id and item.tipe = 'Half_Goods' LIMIT 1 ) uraian_barang_setengah_jadi,
(select item.total_doc from lpa_inspeksi_item item where item.id_lpa_inspeksi = b.id and item.tipe = 'Half_Goods' LIMIT 1 ) doc_barang_setengah_jadi,
(select item.total_fisik from lpa_inspeksi_item item where item.id_lpa_inspeksi = b.id and item.tipe = 'Half_Goods' LIMIT 1 ) fisik_barang_setengah_jadi,
(select count(*) from lpa_inspeksi_item item where item.id_lpa_inspeksi = b.id and item.tipe = 'Raw_Materials' ) count_bahan_baku,
(select item.nama from lpa_inspeksi_item item where item.id_lpa_inspeksi = b.id and item.tipe = 'Raw_Materials' LIMIT 1 ) uraian_bahan_baku,
(select item.total_doc from lpa_inspeksi_item item where item.id_lpa_inspeksi = b.id and item.tipe = 'Raw_Materials' LIMIT 1 ) doc_bahan_baku,
(select item.total_fisik from lpa_inspeksi_item item where item.id_lpa_inspeksi = b.id and item.tipe = 'Raw_Materials' LIMIT 1 ) fisik_bahan_baku
from lpa_umum a
left join lpa_inspeksi b on b.id_lpa_umum = a.id
left join lpa_inspeksi_item c on c.id_lpa_inspeksi = b.id
left join data_umum e on a.id_data_umum = e.id
where a.id = $P{PIdLpaUmum}
LIMIT 1]]>
	</queryString>
