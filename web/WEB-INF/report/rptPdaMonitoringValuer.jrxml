	<subDataset name="dataset3" uuid="bbe2c4c0-7733-4906-86f2-7d1ef1754e5b">
		<parameter name="pUser" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from person
where user_id = $P{pUser}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<parameter name="pSubmitDate" class="java.sql.Timestamp">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pClosedDate" class="java.sql.Timestamp">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pUser" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pUser2" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select c.*, (select nama from person where user_id = c.svy_code) svy_name,
(select nama from person where user_id = c.created_by) val_name, to_char(d.tanggal, 'dd-MM-yyyy hh:mm:ss') tgl
from data_umum a,
data_detail b,
survey_umum d,
mob_tbl_order c
where a.id=b.id_data_umum
and b.id_data_umum = a.id
and d.id_data_detail = b.id
and c.order_no = a.no_order
and d.tanggal between $P{pSubmitDate} and $P{pClosedDate}
 $P!{pUser2}]]>
	</queryString>
