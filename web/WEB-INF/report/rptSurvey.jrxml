	<subDataset name="negatif_point" uuid="cb59f388-2010-4fc4-ac1f-32536d6ebb5a">
		<parameter name="PIdDataDetail" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select c.value
from survey_point a
inner join survey_negatif_point b on b.id_parameter = a.id
inner join parameter c on c.id = b.id_survey_point
where a.id_data_detail =$P{PIdDataDetail}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<subDataset name="pertimbangan_khusus" uuid="57ee80a2-407e-4d15-ad7b-2b2b44afa54f">
		<parameter name="PIdDataDetail" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select c.value
from survey_point a
inner join survey_pertimbangan_khusus b on b.id_parameter = a.id
inner join parameter c on c.id = b.id_survey_point
where a.id_data_detail = $P{PIdDataDetail}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset1" uuid="8bdc5477-5628-400d-859b-41c9ba0fa15b">
		<parameter name="PIdDataDetail" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.kontak_nama,
a.jenis_object,
a.kontak_telp,
a.alamat,
a.kondisi_lingkungan,
a.kondisi_bangunan,
a.keterangan
from survey_pembanding a
where a.id_data_detail = $P{PIdDataDetail}]]>
		</queryString>
		<field name="kontak_nama" class="java.lang.String"/>
		<field name="jenis_object" class="java.lang.String"/>
		<field name="kontak_telp" class="java.lang.String"/>
