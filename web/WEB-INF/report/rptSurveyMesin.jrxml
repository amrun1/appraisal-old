	<subDataset name="dataset1_1" uuid="84d4f17a-3505-4e5b-a6ef-63b339df5100">
		<parameter name="pId" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.value
from parameter a
where a.id::text = $P{pId}]]>
		</queryString>
		<field name="value" class="java.lang.String"/>
	</subDataset>
	<parameter name="PIdDataDetail" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select b.nama,
b.nama_contact_person,
b.telp_contact_person,
a.waktu,
a.alamat,
a.keterangan_drop,
c.nama jenis_object_penilaian,
a.status_survey,
--data umum
d.hasil_survey,
d.id  no_survey,
d.lokasi,
d.dihuni,
d.ditinjau,
d.catatan_survey,
d.jenis_objek,
d.digunakan,
d.ditemui,
d.tanggal,
--data point
h.catatan,
--data mesin
f.jenis_mesin,
f.merk_mesin,
f.type_mesin,
f.no_seri,
f.asal_pembuatan,
f.tahun_pembuatan,
f.kegunaan,
f.kondisi_mesin,
f.jumlah_unit,
f.rangkaian_mesin,
f.waktu_penggunaan,
--operasional mesin
e.tempat_operasional,
e.kondisi_tempat,
e.lingkungan_sekitar,
e.teknisi,
e.suku_cadang,
e.catatan catatan_mesin
from data_detail a
left join data_umum b on a.id_data_umum = b.id
left join jenis_aktiva c on c.id = a.id_jenis_aktiva
left join survey_umum d on a.id = d.id_data_detail
left join survey_mesin e on e.id_data_detail = a.id
left join survey_mesin_lampiran f on f.id_survey_mesin = e.id
left join survey_point h on h.id_data_detail = a.id
where a.id = $P{PIdDataDetail}
LIMIT 1]]>
	</queryString>
