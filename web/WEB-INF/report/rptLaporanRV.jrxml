<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptFormatLpaInt" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="946a5f3a-518d-4c84-bee0-9a8d272b969a">
	<property name="ireport.zoom" value="1.8150000000000108"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="2464"/>
	<subDataset name="dataset1" uuid="17888e97-41f6-41a1-8a7d-eec1101fea67">
		<parameter name="idrv" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select * from lparv_fotopada where lparv_id = $P{idrv}]]>
		</queryString>
		<field name="lparv_id" class="java.lang.Long"/>
		<field name="fotopada" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset2" uuid="eff1bd44-e800-4db6-9f3e-ba3b927b5e82">
		<parameter name="idrv" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select f
from(
select b.no_telepon f
from lpa_rv b
where b.id=$P{idrv}
union
select case when b.ada_car_port!= false then 'Carport' else '' end f
from lpa_rv b
where b.id=$P{idrv}
union
select case when b.ada_garasi!=false then 'Garasi' else '' end  f
from lpa_rv b
where b.id=$P{idrv}) fasilitas
where f!='']]>
		</queryString>
		<field name="f" class="java.lang.String"/>
	</subDataset>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select b.id id_rv, a.no_lpa,
a.nama_contact,
a.nama_debitur,
a.nama_perumahan,
a.lokasi_fisik,
a.kota,
a.kode_pos,
a.ditinjau nama_surveyor,
a.tanggal_order,
a.tanggal_survey,
a.tanggal_terima_dari_eks,
b.lokasi_ditemukan,
b.sudah_pindah,
b.s1_ditemukan,
b.s1_nama,
b.s1_kelamin,
b.s1_hubungan,
b.s1_kooperatif,
--s2
b.s2_ditemukan,
b.s2_nama,
b.s2_kelamin,
b.s2_hubungan,
b.s2_kenal,
b.s2_kooperatif,
--s2
b.s3_ditemukan,
b.s3_nama,
b.s3_kelamin,
b.s3_hubungan,
b.s3_kenal,
b.s3_kooperatif,
--
b.diterima_di,
b.lama_penempatan,
b.lingkungan_sekitar,
b.luas_bangunan,
b.luas_tanah,
b.jenis_bangunan,
b.info_s1,
b.info_s2,
b.info_s3, b.note,
b.umur,
b.kondisi_rumah,
b.penghuni,
b.dikenal_nama_sama,
b.didatangi_debt_collector,
b.status_kepemilikan,
b.no_telepon,
b.ada_car_port,
b.ada_garasi,
(select nama from person where user_id = e.closed_by ) approve_by,
e.closed_date approve_date,
(select nama from person where user_id = e.value_by ) value_by,
e.value_date
from lpa_umum a
inner join lpa_rv b on b.id_lpa_umum = a.id
left join data_umum e on a.id_data_umum = e.id
where a.id=$P{PIdLpaUmum}]]>
	</queryString>
