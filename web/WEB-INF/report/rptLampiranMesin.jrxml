		<variableExpression><![CDATA[$F{nilai_dokumen}]]></variableExpression>
	</variable>
	<variable name="vNilaiFisik" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_fisik}]]></variableExpression>
	</variable>
