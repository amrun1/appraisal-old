	<subDataset name="dataset1" uuid="871a62a1-6b82-4096-9cd7-650ca84fb431">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from cabang
where id = $P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset2" uuid="713c939d-6c8f-4d53-83ce-e1b0afe28513">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from jenis_aktiva
where id =$P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset3" uuid="9cf77a9f-0118-4575-b737-ee88331a4ad2">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from appraisal_cabang
where id = $P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset4" uuid="1939fd63-99b2-4a62-a685-ba7aa50e0928">
		<parameter name="pUserId" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select distinct(a.nama) as nama
from person a,
person_roles b
where a.user_id = b.user_id
and b.person_level = 'MARKETING'
and a.user_id = $P{pUserId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<parameter name="pSubmitDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pCloseDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pCabangId" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pAppraisalCabangId" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select count(c.nama), c.nama, date(b.submit_date), c.id
from data_detail a
left join data_umum b on a.id_data_umum = b.id
left join (select case x.id when -1 then y.kategori_appraisal else x.nama end nama, x.id id, y.id id_umum from jenis_appraisal x, data_umum y where x.id = y.jenis_appraisal_id and y.kategori_appraisal is not null) c on c.id_umum = b.id
where b.cabang_id = $P{pCabangId}
and b.appraisal_cabang_id = $P{pAppraisalCabangId}
and b.kategori_appraisal is not null
and date(b.submit_date) >= $P{pSubmitDate} and date(b.closed_date) <= $P{pCloseDate}
group by c.nama,
 date(b.submit_date), c.id
order by date(b.submit_date) asc]]>
	</queryString>
	<field name="count" class="java.lang.Long"/>
	<field name="nama" class="java.lang.String"/>
	<field name="date" class="java.sql.Date"/>
	<field name="id" class="java.lang.Long"/>
	<variable name="vOther" class="java.lang.Long" resetType="Group" resetGroup="date" calculation="Sum">
		<variableExpression><![CDATA[$F{id}!= -1 && $F{id}!= -2 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vEksternal" class="java.lang.Long" resetType="Group" resetGroup="date" calculation="Sum">
		<variableExpression><![CDATA[!$F{nama}.equals( "Internal" ) && $F{id}!= -2 && $F{id}!= -3&& $F{id}!= -4&& $F{id}!= -5&& $F{id}!= -6 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vInternal" class="java.lang.Long" resetType="Group" resetGroup="date" calculation="Sum">
		<variableExpression><![CDATA[!$F{nama}.equals( "Eksternal" ) && $F{id}!= -2 && $F{id}!= -3&& $F{id}!= -4&& $F{id}!= -5&& $F{id}!= -6 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vIndikasi" class="java.lang.Long" resetType="Group" resetGroup="date" calculation="Sum">
		<variableExpression><![CDATA[$F{id}!= -1 && $F{id}!= -3&& $F{id}!= -4&& $F{id}!= -5&& $F{id}!= -6 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vOtherTotal" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{id}!= -1 && $F{id}!= -2 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vEksternalTotal" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[!$F{nama}.equals( "Internal" ) && $F{id}!= -2 && $F{id}!= -3&& $F{id}!= -4&& $F{id}!= -5&& $F{id}!= -6 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vInternalTotal" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[!$F{nama}.equals( "Eksternal" ) && $F{id}!= -2 && $F{id}!= -3&& $F{id}!= -4&& $F{id}!= -5&& $F{id}!= -6 ? $F{count} :0]]></variableExpression>
	</variable>
	<variable name="vIndikasiTotal" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{id}!= -1 && $F{id}!= -3&& $F{id}!= -4&& $F{id}!= -5&& $F{id}!= -6 ? $F{count} :0]]></variableExpression>
	</variable>
