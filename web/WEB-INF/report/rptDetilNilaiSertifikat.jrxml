	<field name="nilai_likuidasi_doc_eks" class="java.math.BigDecimal"/>
	<field name="bangunan_nilai_likuidasi_doc" class="java.math.BigDecimal"/>
	<field name="bangunan_nilai_likuidasi_doc_eks" class="java.math.BigDecimal"/>
