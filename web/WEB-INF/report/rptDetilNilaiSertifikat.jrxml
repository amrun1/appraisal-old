	<variable name="total_nilai_pasar_doc_eks" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_pasar_doc_eks}]]></variableExpression>
	</variable>
	<variable name="total_nilai_pasar_doc" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_pasar_doc}]]></variableExpression>
	</variable>
	<variable name="total_nilai_likuidasi_doc_eks" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_likuidasi_doc_eks}]]></variableExpression>
	</variable>
