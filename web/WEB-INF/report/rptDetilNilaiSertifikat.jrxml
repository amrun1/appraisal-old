	<field name="total_luas_tanah" class="java.lang.Double"/>
	<field name="nilai_pasar_doc_eks" class="java.math.BigDecimal"/>
	<field name="nilai_pasar_doc" class="java.math.BigDecimal"/>
	<field name="bangunan_nilai_pasar_doc_eks" class="java.math.BigDecimal"/>
	<field name="bangunan_nilai_pasar_doc" class="java.math.BigDecimal"/>
	<field name="nilai_pasar_fisik_eks" class="java.math.BigDecimal"/>
	<field name="nilai_pasar_fisik" class="java.math.BigDecimal"/>
