	</variable>
	<variable name="total_nilai_likuidasi_fisik_eks" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_likuidasi_fisik_eks}]]></variableExpression>
	</variable>
	<variable name="total_nilai_likuidasi_fisik" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_likuidasi_fisik}]]></variableExpression>
	</variable>
