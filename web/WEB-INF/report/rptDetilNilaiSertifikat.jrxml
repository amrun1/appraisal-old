				<textFieldExpression><![CDATA[$F{datatype}.equalsIgnoreCase("Eksternal")? ($V{total_nilai_likuidasi_fisik_eks}.add($F{bangunan_nilai_likuidasi_fisik}).toString().equals("0.00") ? "-" : new java.text.DecimalFormat("Rp #,###").format($V{total_nilai_likuidasi_fisik_eks}.add($F{bangunan_nilai_likuidasi_fisik_eks}))) : ($V{total_nilai_likuidasi_fisik}.add($F{bangunan_nilai_likuidasi_fisik}).toString().equals("0.00") ? "-" : new java.text.DecimalFormat("Rp #,###").format($V{total_nilai_likuidasi_fisik}.add($F{bangunan_nilai_likuidasi_fisik})))]]></textFieldExpression>
