					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{datatype}.equalsIgnoreCase("Eksternal") ? ($F{nilai_pasar_doc_eks}.toString().equals("0") ? "-" : new java.text.DecimalFormat("Rp #,##0").format($F{nilai_pasar_doc_eks})  ): ( $F{nilai_pasar_doc}.toString().equals("0.00") ? "-" : new java.text.DecimalFormat("Rp #,##0").format($F{nilai_pasar_doc}) )]]></textFieldExpression>
