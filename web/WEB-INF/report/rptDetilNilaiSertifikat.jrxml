			<textField isStretchWithOverflow="true" pattern="#,##0.00;-#,##0.00" isBlankWhenNull="false">
				<reportElement uuid="39477241-e257-426a-93f3-3b22958379c8" positionType="Float" mode="Transparent" x="303" y="0" width="125" height="20" forecolor="#000000" backcolor="#FFFFFF"/>
