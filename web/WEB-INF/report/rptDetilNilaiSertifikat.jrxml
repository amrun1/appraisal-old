<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptDetilNilaiSertifikat" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e522da80-127a-4260-93e1-e50cbe678438">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PImagePath" class="java.lang.String" isForPrompting="false"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<parameter name="PIdLpaUmum" class="java.lang.Long"/>
	<queryString>
		<![CDATA[WITH total_luas_tanah AS(
	select SUM(ldt.luas_tanah) AS total, lu.id from lpa_umum lu
	left join lpa_tanah_bangunan ltb on lu.id = ltb.id_lpa_umum
	left join lpa_doc_tanah ldt on ltb.id = ldt.id_lpa_lnb
	where lu.id = $P{PIdLpaUmum}
	group by lu.id
)
select
	a.nomor_order,
	a.nama_debitur,
	a.lokasi_fisik,
	d.nama jenis_dokumen,
	c.nama_dokumen no_dokumen,
	c.luas_tanah,
	tl.total total_luas_tanah,
	b.nilai_doc_1_eks/tl.total*c.luas_tanah 					nilai_pasar_doc_eks ,
	b.nilai_dokumen_1/tl.total*c.luas_tanah 					nilai_pasar_doc,
	b.nilai_doc_2_eks 												bangunan_nilai_pasar_doc_eks,
	b.nilai_dokumen_2 												bangunan_nilai_pasar_doc,
	b.nilai_fisik_1_eks/tl.total*c.luas_tanah 				nilai_pasar_fisik_eks,
	b.nilai_fisik_1/tl.total*c.luas_tanah 						nilai_pasar_fisik,
	b.nilai_fisik_2_eks 												bangunan_nilai_pasar_fisik_eks,
	b.nilai_fisik_2 													bangunan_nilai_pasar_fisik,
	b.likuidasi_doc_1/tl.total*c.luas_tanah 					nilai_likuidasi_doc,
	b.likuidasi_doc_1_eks/tl.total*c.luas_tanah 				nilai_likuidasi_doc_eks,
	b.likuidasi_doc_2 												bangunan_nilai_likuidasi_doc,
	b.likuidasi_doc_2_eks 											bangunan_nilai_likuidasi_doc_eks,
	b.likuidasi_fisik_1/tl.total*c.luas_tanah 				nilai_likuidasi_fisik,
	b.likuidasi_fisik_1_eks/tl.total*c.luas_tanah 			nilai_likuidasi_fisik_eks,
	b.likuidasi_fisik_2								 				bangunan_nilai_likuidasi_fisik,
	b.likuidasi_fisik_2_eks								 			bangunan_nilai_likuidasi_fisik_eks,
	b.luas_bangunan luas_bangunan_fisik,
	b.luas_bangunan_imb luas_bangunan_doc,
	du.kategori_appraisal DataType
from lpa_umum a
left join lpa_tanah_bangunan b on a.id = b.id_lpa_umum
left join lpa_doc_tanah c on b.id = c.id_lpa_lnb
left join data_umum du on du.no_order = a.nomor_order
inner join jenis_dokumen d on d.id = c.id_jenis_dokumen
LEFT JOIN total_luas_tanah tl ON tl.id = a.id
where  a.id = $P{PIdLpaUmum}
order by  c.id asc]]>
	</queryString>
