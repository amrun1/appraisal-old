	<subDataset name="user" uuid="99a093ef-c0fb-4893-9876-353ba112ef87">
		<parameter name="pUserId" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select distinct a.nama
from person a
-- , person_roles b
where a.user_id = $P{pUserId}
-- and a.user_id = b.user_id]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<parameter name="pRole" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pUserId" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pSubmitDate" class="java.sql.Timestamp">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pClosedDate" class="java.sql.Timestamp">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select distinct logs.*
from person_roles role
left join security_log logs on logs.person_userid=role.user_id
where (role.person_level=$P{pRole} or $P{pRole} is null or $P{pRole} = '')
and (logs.person_userid=$P{pUserId} or $P{pUserId} is null or $P{pUserId}= '')
and logs.date_time BETWEEN $P{pSubmitDate} and $P{pClosedDate}
order by logs.date_time desc, logs.person_userid asc]]>
	</queryString>
	<field name="id" class="java.lang.Long"/>
	<field name="ipaddress" class="java.lang.String"/>
	<field name="keterangan" class="java.lang.String"/>
	<field name="log_code" class="java.lang.Long"/>
	<field name="person_userid" class="java.lang.String"/>
	<field name="date_time" class="java.sql.Timestamp"/>
	<field name="app_name" class="java.lang.String"/>
	<field name="computer_name" class="java.lang.String"/>
	<field name="detail_event" class="java.lang.String"/>
	<field name="user_affected" class="java.lang.String"/>
