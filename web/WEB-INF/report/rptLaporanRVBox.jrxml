<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptFormatLpaInt" pageWidth="759" pageHeight="910" whenNoDataType="AllSectionsNoDetail" columnWidth="719" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="ace446c3-a922-4360-a4c7-20c02c638944">
