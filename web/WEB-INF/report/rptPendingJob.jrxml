	<subDataset name="user_1" uuid="ff76d574-3b09-4481-9f68-18fb2812e8f2">
		<parameter name="pUserId" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.nama
from person a,
person_roles b
where a.user_id = b.user_id
and a.user_id = $P{pUserId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<parameter name="pCabangApppraisal" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pPosisi" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pUserId" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pUserName" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="pTimUser" class="java.lang.Integer"/>
	<parameter name="pPos" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pCabangTxt" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select c.id,
c.no_order,
c.nama nama_debitur,
c.survey_by,
c.admin_by,
c.value_by,
c.closed_by,
c.created_by,
c.status_jaminan_id,
c.created_by,
c.appraisal_cabang_id cabang,
c.cabang_id bisnis,
b.id_jenis_aktiva object_penilaian,
b.alamat lokasi_agunan,
b.kode_kota,
b.kode_propinsi,
b.kode_pos,
c.value_date,
b.luas_tanah,
b.luas_bangunan,
c.kategori_appraisal jenis_lpa,
c.jenis_appraisal_id,
c.jenis_laporan,
c.submit_date,
d.tanggal_survey as survey_date,
f_is_next_day(c.submit_date) tgl_cot,
jumlah_hari(c.submit_date, now()::timestamp) waktu_proses, c.posisi, c.task_list,
(select case when du.kategori_appraisal = 'Internal' then 'Internal' when du.kategori_appraisal = 'Eksternal' then 'Eksternal' else ja.nama end nama
from jenis_appraisal ja
left outer join data_umum du on ja.id=du.jenis_appraisal_id
where ja.id = c.jenis_appraisal_id
and du.id = c.id) jenis_appraisal,
(select nama from cabang where id =c.cabang_id) bisnis_name,
(select nama from status_jaminan where id = c.status_jaminan_id) status_jaminan,
(select nama from jenis_aktiva where id =b.id_jenis_aktiva) jenis_aktiva,
(select distinct(a.nama) as nama
from person a,
person_roles b
where a.user_id = b.user_id
and a.user_id = c.task_list) nama_task
from data_detail b
left join data_umum c on c.id = b.id_data_umum
left join lpa_umum d on d.nomor_order = c.no_order
where c.appraisal_cabang_id=$P{pCabangApppraisal}
and c.submit_date is not null
and c.posisi = $P{pPos}
-- and c.posisi <> c.task_list
and c.task_list not in ('PLUS', 'CARM')
and c.posisi not in ('CLOSE','DROP')
$P!{pUserId}
$P!{pCabangTxt}]]>
	</queryString>
	<field name="id" class="java.lang.Long"/>
	<field name="no_order" class="java.lang.String"/>
	<field name="nama_debitur" class="java.lang.String"/>
	<field name="survey_by" class="java.lang.String"/>
