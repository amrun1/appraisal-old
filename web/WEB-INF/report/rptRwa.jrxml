<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptRwa" pageWidth="3260" pageHeight="612" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="3260" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="61bfb464-5880-4448-bf39-052a956218bd">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="net.sf.jasperreports.export.xls.remove.empty.space.between.rows" value="true"/>
	<property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
	<subDataset name="user" uuid="8833413e-4cf3-41f0-89bf-7e525e9c2d28">
		<parameter name="pUserId" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.nama
from person a
where a.user_id = $P{pUserId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<parameter name="pCloseDate" class="java.sql.Timestamp">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pSubmitDate" class="java.sql.Timestamp">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    prog.head_id,
    prog.id_rwa,
    prog.DOWN_DATE,
    prog.ACCOUNT_NO,
    prog.CIF_JHA AS CUST_NO,
    prog.NAME,
    prog.PLAFOND,
    prog.OUTSTANDING,
    prog.MATUR_DATE,
    prog.COLLATERAL_ID,
    prog.group_val,
    CASE
        WHEN prog.APR_EXT_DATE IS NOT NULL
        THEN 'EXTERNAL'
        WHEN prog.APR_INT_DATE IS NOT NULL
        THEN 'INTERNAL'
    END AS VAL_TYPE,prog.APR_EXT_DATE,prog.APR_INT_DATE,
    CASE
        WHEN prog.APR_EXT_DATE IS NOT NULL
        THEN prog.APR_EXT_DATE
        ELSE prog.APR_INT_DATE
    END AS VAL_DATE,
    CASE
        WHEN prog.EXT_VAL_CODE IS NOT NULL
        THEN prog.EXT_VAL_CODE
        ELSE prog.INT_VAL_CODE
    END AS VAL_NAME,
    CASE
        WHEN prog.EXT_LAND_APR_DOC IS NOT NULL
        THEN prog.EXT_LAND_APR_DOC
        ELSE prog.INT_LAND_APR_DOC
    END AS LAND_DOC,
    CASE
        WHEN prog.EXT_BLD_APR_DOC IS NOT NULL
        THEN prog.EXT_BLD_APR_DOC
        ELSE prog.INT_BLD_APR_DOC
    END AS BLD_DOC,
    CASE
        WHEN prog.EXT_TOT_DOC IS NOT NULL
        THEN prog.EXT_TOT_DOC
        ELSE prog.INT_TOT_DOC
    END AS TOT_DOC,
    CASE
        WHEN prog.EXT_LAND_APR_FISIK IS NOT NULL
        THEN prog.EXT_LAND_APR_FISIK
        ELSE prog.INT_LAND_APR_FISIK
    END AS LAND_FISIK,
    CASE
        WHEN prog.EXT_BLD_APR_FISIK IS NOT NULL
        THEN prog.EXT_BLD_APR_FISIK
        ELSE prog.INT_BLD_APR_FISIK
    END AS BLD_FISIK,
    CASE
        WHEN prog.EXT_TOT_FISIK IS NOT NULL
        THEN prog.EXT_TOT_FISIK
        ELSE prog.INT_TOT_FISIK
    END AS TOT_FISIK,
    umum.value_date,
    umum.value_by,
    case when tnh.nilai_doc_1_eks is not null then tnh.nilai_doc_1_eks else tnh.nilai_dokumen_1 end NILTNHDOK,
    case when tnh.nilai_doc_2_eks is not null then tnh.nilai_doc_2_eks else tnh.nilai_dokumen_2 end NILBGNDOK,
    case when tnh.total_doc_eks is not null then tnh.total_doc_eks else tnh.total_sesuai_doc end TOTNILDOK,
    case when tnh.nilai_fisik_1_eks is not null then tnh.nilai_fisik_1_eks else tnh.nilai_fisik_1 end NILTNHFISIK,
    case when tnh.nilai_fisik_2_eks is not null then tnh.nilai_fisik_2_eks else tnh.nilai_fisik_2 end NILBGNFISIK,
    case when tnh.total_fisik_eks is not null then tnh.total_fisik_eks else tnh.total_sesuai_fisik end TOTNILFISIK,
    prog.status_data,
    prog.status_data STATUS,
    prog.id, prog.id_data_umum, umum.id id_umum, lpa.id, tnh.id
FROM data_umum umum
    inner join iloan_progres prog on prog.id_data_umum=umum.id
    left join lpa_umum lpa on lpa.id_data_umum=umum.id
    left join public.lpa_tanah_bangunan tnh on tnh.id_lpa_umum = lpa.id
where umum.closed_date between $P{pSubmitDate} and $P{pCloseDate}
order by prog.id]]>
	</queryString>
	<field name="head_id" class="java.lang.Long"/>
	<field name="id_rwa" class="java.lang.Long"/>
	<field name="down_date" class="java.sql.Timestamp"/>
	<field name="account_no" class="java.lang.String"/>
	<field name="cust_no" class="java.lang.String"/>
	<field name="name" class="java.lang.String"/>
	<field name="plafond" class="java.math.BigDecimal"/>
	<field name="outstanding" class="java.math.BigDecimal"/>
	<field name="matur_date" class="java.sql.Timestamp"/>
	<field name="collateral_id" class="java.lang.String"/>
	<field name="group_val" class="java.lang.String"/>
	<field name="val_type" class="java.lang.String"/>
	<field name="apr_ext_date" class="java.sql.Timestamp"/>
	<field name="apr_int_date" class="java.sql.Timestamp"/>
	<field name="val_date" class="java.sql.Timestamp"/>
	<field name="val_name" class="java.lang.String"/>
	<field name="land_doc" class="java.math.BigDecimal"/>
	<field name="bld_doc" class="java.math.BigDecimal"/>
	<field name="tot_doc" class="java.math.BigDecimal"/>
	<field name="land_fisik" class="java.math.BigDecimal"/>
	<field name="bld_fisik" class="java.math.BigDecimal"/>
	<field name="tot_fisik" class="java.math.BigDecimal"/>
	<field name="value_date" class="java.sql.Timestamp"/>
	<field name="value_by" class="java.lang.String"/>
	<field name="niltnhdok" class="java.math.BigDecimal"/>
	<field name="nilbgndok" class="java.math.BigDecimal"/>
	<field name="totnildok" class="java.math.BigDecimal"/>
	<field name="niltnhfisik" class="java.math.BigDecimal"/>
	<field name="nilbgnfisik" class="java.math.BigDecimal"/>
	<field name="totnilfisik" class="java.math.BigDecimal"/>
	<field name="status_data" class="java.lang.Integer"/>
	<field name="status" class="java.lang.Integer"/>
	<field name="id" class="java.lang.Long"/>
	<field name="id_data_umum" class="java.lang.Long"/>
	<field name="id_umum" class="java.lang.Long"/>
	<variable name="vDiff" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{tot_fisik}.equals( new BigDecimal("0.00") ) ? new BigDecimal("0") : ((($F{totnilfisik} !=null ? $F{totnilfisik}:new BigDecimal("0") ).subtract(($F{tot_fisik}!=null ? $F{tot_fisik}:new BigDecimal("0")))).multiply(new BigDecimal("100")).divide(($F{tot_fisik}!=null ? $F{tot_fisik}:new BigDecimal("0")), 0, RoundingMode.HALF_UP))]]></variableExpression>
	</variable>
