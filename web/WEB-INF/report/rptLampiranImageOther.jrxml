<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptFormatLpaInt" columnCount="2" printOrder="Horizontal" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="277" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="244fabbf-06a1-4ba6-9400-41ac596feea1">
	<property name="ireport.zoom" value="1.500000000000002"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="net.sf.jasperreports.engine.util.JRImageLoader" value="true"/>
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="PIdLpaUmum" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<parameter name="PImagePath" class="java.lang.String"/>
	<queryString>
		<![CDATA[select a.no_lpa,
a.nama_debitur,
a.lokasi_fisik, b.id_laporan_dokumen,
lo_get(b.image) img, b.nama ket, b.catatan,
(select nama from jenis_kategori where kode = a.kategori_aktiva) kategori
from lpa_umum a
left outer join (
select b.id_laporan_dokumen, b.image, c.nama, b.catatan, b.id_survey_umum, b.id_lpa
from survey_image b
	left outer join jenis_laporan_dokumen c on b.id_laporan_dokumen = c.id
where c.jenis_data='Lain-Lain'
) as b
	on a.id_survey = b.id_survey_umum or a.id = b.id_lpa
where a.id =$P{PIdLpaUmum}
order by B.nama]]>
	</queryString>
	<field name="no_lpa" class="java.lang.String"/>
	<field name="nama_debitur" class="java.lang.String"/>
	<field name="lokasi_fisik" class="java.lang.String"/>
	<field name="id_laporan_dokumen" class="java.lang.Long"/>
	<field name="img" class="java.io.InputStream"/>
