	<subDataset name="dataset2" uuid="088a5737-95d0-4e8c-8249-965d94c80a66">
		<parameter name="PIdDataDetail" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.kontak_nama,
a.jenis_object,
a.kontak_telp,
a.alamat,
a.kondisi_lingkungan,
a.kondisi_bangunan,
a.keterangan
from survey_pembanding a
where a.id_data_detail = $P{PIdDataDetail}]]>
		</queryString>
		<field name="kontak_nama" class="java.lang.String"/>
		<field name="jenis_object" class="java.lang.String"/>
		<field name="kontak_telp" class="java.lang.String"/>
		<field name="alamat" class="java.lang.String"/>
		<field name="kondisi_lingkungan" class="java.lang.String"/>
		<field name="kondisi_bangunan" class="java.lang.String"/>
		<field name="keterangan" class="java.lang.String"/>
	</subDataset>
	<parameter name="PIdDataDetail" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select b.nama,
b.nama_contact_person,
b.telp_contact_person,
a.waktu,
a.alamat,
a.keterangan_drop,
c.nama jenis_object_penilaian,
a.status_survey,
--data umum
d.hasil_survey,
d.id  no_survey,
d.lokasi,
d.dihuni,
d.ditinjau,
d.catatan_survey,
d.jenis_objek,
d.digunakan,
d.ditemui,
d.tanggal,
--data point
h.catatan,
--data kendaraan
e.jenis,
e.merk,
e.model,
e.silinder,
e.tahun_pembuatan,
e.warna,
e.no_polisi,
e.no_rangka,
e.no_mesin,
e.bahan_bakar,
e.penggunaan,
e.kilometer,
e.catatan catatan_kendaraan
from data_detail a
left join data_umum b on a.id_data_umum = b.id
left join jenis_aktiva c on c.id = a.id_jenis_aktiva
left join survey_umum d on a.id = d.id_data_detail
left join survey_kendaraan e on e.id_data_detail = a.id
left join survey_point h on h.id_data_detail = a.id
where a.id = $P{PIdDataDetail}
LIMIT 1]]>
	</queryString>
