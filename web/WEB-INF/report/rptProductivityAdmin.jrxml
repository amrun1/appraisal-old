		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<parameter name="pCabangApppraisal" class="java.lang.Long">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pPosisi" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pSubmitDate" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pCloseDate" class="java.sql.Timestamp">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pUserId" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pUserName" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="pTimUser" class="java.lang.Integer"/>
	<parameter name="pCabang" class="java.lang.Long"/>
	<parameter name="pCabangDesk" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select c.id,
c.no_order,
c.nama nama_debitur,
c.status_jaminan_id,
c.cabang_id bisnis,
b.id_jenis_aktiva object_penilaian,
b.alamat lokasi_agunan,
c.kategori_appraisal jenis_lpa,
c.jenis_appraisal_id,
c.jenis_laporan,
d.tgl_claim,
(select nama from status_jaminan where id = a.id_status_jaminan) status_jaminan,
(select nama from cabang where id = c.cabang_id) cb_bisnis,
(select nama from jenis_aktiva where id = b.id_jenis_aktiva) obj_nilai,
(select nama from jenis_appraisal where id = c.jenis_appraisal_id) jenis_app
from data_detail b
left join data_umum c on c.id = b.id_data_umum
left join lpa_umum a on a.id_data_umum = b.id
left join (select max(id), max(tanggal) tgl_claim, id_data_umum id_umum
from task_flow_history
where catatan='Admin Appraisal Claim'
group by id_data_umum) d on d.id_umum = c.id
where c.appraisal_cabang_id=$P{pCabangApppraisal} and d.tgl_claim between $P{pSubmitDate} and $P{pCloseDate}
and c.submit_date is not null
and c.closed_date is not null
$P!{pUserId}]]>
	</queryString>
	<field name="id" class="java.lang.Long"/>
	<field name="no_order" class="java.lang.String"/>
	<field name="nama_debitur" class="java.lang.String"/>
	<field name="status_jaminan_id" class="java.lang.Long"/>
	<field name="bisnis" class="java.lang.Long"/>
	<field name="object_penilaian" class="java.lang.Long"/>
	<field name="lokasi_agunan" class="java.lang.String"/>
	<field name="jenis_lpa" class="java.lang.String"/>
	<field name="jenis_appraisal_id" class="java.lang.Long"/>
	<field name="jenis_laporan" class="java.lang.String"/>
	<field name="tgl_claim" class="java.sql.Timestamp"/>
	<field name="status_jaminan" class="java.lang.String"/>
	<field name="cb_bisnis" class="java.lang.String"/>
	<field name="obj_nilai" class="java.lang.String"/>
	<field name="jenis_app" class="java.lang.String"/>
