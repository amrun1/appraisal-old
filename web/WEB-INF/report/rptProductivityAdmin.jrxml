	<subDataset name="Bisnis" uuid="a4058ca4-1e99-4be1-932a-cfe44a1eaa26">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from cabang
where id = $P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="Cabang" uuid="9610bbbd-9889-4468-9cae-c61f5bd4e528">
		<parameter name="pId" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select nama
from appraisal_cabang
where id = $P{pId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="JenisAppraisal" uuid="1d62a598-ac2e-4569-b0d3-b81f1af216e2">
		<parameter name="id" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="id_umum" class="java.lang.Long">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select case when b.kategori_appraisal = 'Internal' then 'Internal' when b.kategori_appraisal = 'Eksternal' then 'Eksternal' else a.nama end nama
from jenis_appraisal a
left outer join data_umum b on a.id=b.jenis_appraisal_id
where a.id = $P{id}
and b.id = $P{id_umum}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="user" uuid="3fc85db7-4de2-401f-972a-597d8e924b1f">
		<parameter name="pUserId" class="java.lang.String">
			<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select a.nama
from person a
and a.user_id = $P{pUserId}]]>
		</queryString>
		<field name="nama" class="java.lang.String"/>
	</subDataset>
	<subDataset name="statusJaminan" uuid="d3ad3e69-1f41-4bae-b5d3-1669e7c4967a">
